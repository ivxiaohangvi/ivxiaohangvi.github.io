---
import type { CollectionEntry } from 'astro:content';
import MoodBadge from './MoodBadge.astro';
import ProgressiveImg from './ProgressiveImg.astro';
import { withBase } from '../config';
import { beijingDateDot, beijingDay, beijingIso, beijingTime, beijingWeekday, beijingYearMonth } from '../lib/date';
import { moodInfo } from '../lib/mood';
import { plainText } from '../lib/diary-list';
import '../styles/diary.css';

interface Props {
  entries: CollectionEntry<'diary'>[];
  /** 首屏内联 LQIP 的图片预算；滚动加载进来的页与分页回退页都传 0 */
  lqipBudget?: number;
}

const { entries, lqipBudget = 0 } = Astro.props;

let lqipUsed = 0;
const rows = entries.map((entry) => {
  const locked = entry.data.locked === true;
  const images = locked
    ? []
    : entry.data.images.slice(0, 3).map((src) => {
        const useLqip = lqipUsed < lqipBudget;
        if (useLqip) lqipUsed += 1;
        return { src, useLqip };
      });
  // 超过三张时，多出来的数量标在第三张图上，不再另起一格
  const extra = locked ? 0 : Math.max(0, entry.data.images.length - 3);
  return { entry, images, locked, extra };
});

const dayOf = (date: Date) => String(Number(beijingDay(date)));
const ymOf = (date: Date) => beijingYearMonth(date);
const weekdayOf = (date: Date) => beijingWeekday(date);
---

{
  rows.map(({ entry, images, locked, extra }) => (
    <article
      class:list={['ledger-entry', { 'has-thumbs': images.length > 0 || (locked && entry.data.hasEncryptedImages), 'is-locked': locked }]}
      data-pagefind-ignore={locked ? '' : undefined}
      data-reveal
    >
      <div class="entry-side">
        <time
          datetime={beijingIso(entry.data.date)}
          class="entry-date"
          data-rail-date={beijingDateDot(entry.data.date)}
          data-rail-full={`${beijingDateDot(entry.data.date)} ${weekdayOf(entry.data.date)}`}
        >
          <span class="entry-day">{dayOf(entry.data.date)}</span>
          <span class="entry-ym">{ymOf(entry.data.date)}</span>
        </time>
        {moodInfo(entry.data.mood, entry.data.moodKey) ? (
          <MoodBadge mood={entry.data.mood} moodKey={entry.data.moodKey} size="sm" />
        ) : (
          <span class="entry-no-mood">心情未知</span>
        )}
        {entry.data.sample && <span class="sample-stamp">示例</span>}
      </div>

      <div class="entry-main">
        <p class="entry-weekday">
          {weekdayOf(entry.data.date)}
          {entry.data.timeKnown && (
            <>
              <span class="entry-dot" aria-hidden="true">·</span>
              <time class="entry-time" datetime={beijingIso(entry.data.date)}>{beijingTime(entry.data.date)}</time>
            </>
          )}
          <span class="entry-weekday-tail"> / {locked ? 'SEALED NOTE' : entry.data.title ?? 'FIELD NOTE'}</span>
        </p>

        {locked ? (
          <p class="entry-sealed">
            <span class="entry-sealed-lock" aria-hidden="true">
              <svg viewBox="0 0 16 16" focusable="false">
                <rect x="3.2" y="7" width="9.6" height="7" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.2" />
                <path d="M5.2 7V5.2a2.8 2.8 0 0 1 5.6 0V7" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg>
            </span>
            这一页封着。正文与图片都在密文里，输入分享码才能读。
          </p>
        ) : (
          <p class="entry-text">
            {plainText(entry.body).slice(0, 220)}
            {plainText(entry.body).length > 220 ? '…' : ''}
          </p>
        )}

        {entry.data.tags.length > 0 && (
          <p class="diary-tags">
            {entry.data.tags.map((tag) => (
              <a class="diary-tag" href={withBase(`/tags/${tag}/`)}>#{tag}</a>
            ))}
          </p>
        )}

        {locked && entry.data.hasEncryptedImages && (
          <div class="entry-thumbs is-single">
            <span class="entry-thumb is-sealed" aria-label="加密图片占位">
              <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                <rect x="7" y="14" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.2" />
                <path d="M11 14v-4a5 5 0 0 1 10 0v4" fill="none" stroke="currentColor" stroke-width="1.2" />
                <circle cx="16" cy="20" r="1.6" fill="currentColor" />
                <path d="M16 21.4v2.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
              </svg>
              <span>加密图片</span>
            </span>
          </div>
        )}

        {!locked && images.length > 0 && (
          <div class={`entry-thumbs${entry.data.images.length === 1 ? ' is-single' : ''}`}>
            {images.map(({ src, useLqip }, index) => {
              const more = index === 2 ? extra : 0;
              return (
                <button
                  class:list={['entry-thumb', { 'is-more': more > 0 }]}
                  type="button"
                  data-lightbox
                  data-lightbox-link={more > 0 ? withBase(`/diary/${entry.id}/`) : undefined}
                  aria-label={more > 0 ? `进这一页看另外 ${more} 张` : '查看日记图片大图'}
                >
                  <ProgressiveImg src={src} alt="日记配图" variant="thumb" upgrade={false} lqip={useLqip} />
                  {more > 0 && <span class="thumb-more" aria-hidden="true">+{more}</span>}
                </button>
              );
            })}
          </div>
        )}

        <div class="entry-foot">
          <a class="text-link" href={withBase(`/diary/${entry.id}/`)}>
            {locked ? '去解锁' : '读这一页'} <span aria-hidden="true">→</span>
          </a>
          {!locked && entry.data.attachments.length > 0 && (
            <span class="entry-attach">{entry.data.attachments.length} 个附件</span>
          )}
        </div>
      </div>
    </article>
  ))
}
