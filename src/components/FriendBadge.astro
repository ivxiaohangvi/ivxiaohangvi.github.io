---
/**
 * 「互换名片」：把小航自己的站点信息做成一张可复制的名片。
 * 复制内容是一段 Markdown，粘到对方友链页就能用。
 */
import { siteConfig } from '../config';

const host = siteConfig.url.replace(/^https?:\/\//, '').replace(/\/+$/, '');
const markdown = [
  `- **[${siteConfig.siteTitle}](${siteConfig.url})**`,
  `  ${siteConfig.description}`,
].join('\n');
---

<section class="friend-badge" aria-labelledby="friend-badge-title">
  <div class="badge-head">
    <p class="eyebrow">EXCHANGE / 互换名片</p>
    <h2 id="friend-badge-title">把我抄走</h2>
    <p class="badge-lede">想交换的话，抄走这张；或者写封信给我也行。</p>
  </div>

  <div class="badge-card">
    <div class="badge-id">
      <span class="badge-mark" aria-hidden="true">m<span class="inf">∞</span></span>
      <div class="badge-text">
        <p class="badge-name">{siteConfig.siteTitle}</p>
        <p class="badge-host">{host}</p>
      </div>
    </div>

    <dl class="badge-fields">
      <div><dt>站名</dt><dd>{siteConfig.siteTitle}</dd></div>
      <div><dt>地址</dt><dd>{siteConfig.url}</dd></div>
      <div><dt>一句话</dt><dd>{siteConfig.description}</dd></div>
      <div><dt>标签</dt><dd>日记 / 摄影 / 工具 / 长文</dd></div>
    </dl>

    <div class="badge-actions">
      <button type="button" class="badge-copy" data-copy-card data-payload={markdown}>
        复制名片
      </button>
    </div>
  </div>
</section>

<script>
  const COPY_LABEL = '复制名片';
  const DONE_LABEL = '已抄好';

  async function copyText(text: string) {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }
    const area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.opacity = '0';
    document.body.append(area);
    area.select();
    document.execCommand('copy');
    area.remove();
  }

  document.addEventListener('click', async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-copy-card]');
    if (!button) return;

    const hint = button.parentElement?.querySelector<HTMLElement>('[data-copy-hint]');
    const payload = button.dataset.payload ?? '';
    const originalHint = hint?.dataset.original ?? hint?.textContent ?? '';
    if (hint) hint.dataset.original = originalHint;

    try {
      await copyText(payload);
      button.textContent = DONE_LABEL;
      button.classList.add('is-done');
      if (hint) hint.textContent = '已经放进剪贴板了。';
    } catch {
      button.textContent = '复制失败';
      if (hint) hint.textContent = '浏览器没给剪贴板权限，手动选中上面的地址吧。';
    }

    window.setTimeout(() => {
      button.textContent = COPY_LABEL;
      button.classList.remove('is-done');
      if (hint) hint.textContent = originalHint;
    }, 1900);
  });
</script>

<style>
  .friend-badge {
    margin-top: clamp(2.4rem, 5vw, 4rem);
    padding-top: 1.6rem;
    border-top: 1px solid var(--ink);
  }

  .badge-head {
    margin-bottom: 1.1rem;
  }

  .badge-head h2 {
    margin: 0.35rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .badge-lede {
    max-width: 38em;
    font-size: 0.88rem;
    line-height: 1.9;
    color: var(--ink-soft);
  }

  .badge-card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 760px;
    padding: 1.2rem 1.25rem 1.15rem;
    background: var(--card);
    border: 1px solid var(--rule-soft);
    border-radius: 2px;
    box-shadow:
      0 8px 18px -16px rgba(20, 28, 26, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.45);
  }

  .badge-id {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px dashed var(--rule-soft);
  }

  .badge-mark {
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .badge-mark .inf {
    color: var(--brass);
  }

  .badge-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .badge-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
  }

  .badge-host {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .badge-fields {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }

  .badge-fields > div {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: baseline;
  }

  .badge-fields dt {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .badge-fields dd {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .badge-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding-top: 0.2rem;
  }

  .badge-copy {
    padding: 0.5rem 1.05rem;
    background: transparent;
    border: 1px solid var(--brass);
    border-radius: 0;
    color: var(--brass);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition:
      background 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .badge-copy:hover,
  .badge-copy:focus-visible {
    background: var(--brass);
    color: var(--paper);
    outline: none;
  }

  .badge-copy.is-done {
    background: var(--brass);
    color: var(--paper);
  }

  .badge-hint {
    font-size: 0.7rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .badge-fields > div {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 0.5rem;
    }
  }
</style>
