---
import { ClientRouter } from 'astro:transitions';
import { siteConfig, withBase } from '../config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  image?: string;
}

const {
  title,
  description = siteConfig.description,
  noindex = false,
  type = 'website',
  image = '/og.png',
} = Astro.props;

const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.siteTitle;
const site = Astro.site ?? new URL(siteConfig.url);
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={siteConfig.author} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#e8e4d9" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0d1413" media="(prefers-color-scheme: dark)" />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={withBase('/rss.xml')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
{noindex && (
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai" />
)}

<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${siteConfig.title} · ${siteConfig.tagline}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- View Transitions：全站页面平滑转场 -->
<ClientRouter />

<!-- 主题持久化：首屏渲染前应用避免闪烁；astro:after-swap 时对新文档重新应用 -->
<script is:inline>
  (() => {
    const apply = () => {
      const stored = localStorage.getItem('theme');
      document.documentElement.dataset.theme =
        stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.add('js');
    };
    apply();
    document.addEventListener('astro:after-swap', apply);
  })();
</script>
