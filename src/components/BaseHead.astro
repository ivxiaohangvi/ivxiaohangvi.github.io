---
import { ClientRouter } from 'astro:transitions';
import { siteConfig, withBase } from '../config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  image?: string;
}

const {
  title,
  description = siteConfig.description,
  noindex = false,
  type = 'website',
  image = '/og.png',
} = Astro.props;

const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.siteTitle;
const site = Astro.site ?? new URL(siteConfig.url);
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={siteConfig.author} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#e8e4d9" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0d1413" media="(prefers-color-scheme: dark)" />
<link rel="canonical" href={canonicalURL} />
<!-- 图标：SVG 给现代浏览器，位图 ico/png 给 Bing 等只认位图的搜索抓取管线 -->
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
<link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png')} />
<link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={withBase('/rss.xml')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
{noindex && (
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai" />
)}

<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${siteConfig.title} · ${siteConfig.tagline}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- View Transitions：全站页面平滑转场 -->
<ClientRouter />

<!-- 主题持久化：首屏渲染前应用避免闪烁；astro:after-swap 时对新文档重新应用 -->
<script is:inline>
  (() => {
    const apply = () => {
      const stored = localStorage.getItem('theme');
      document.documentElement.dataset.theme =
        stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.add('js');
    };
    apply();
    document.addEventListener('astro:after-swap', apply);
  })();
</script>

<!--
  慢线路兜底的第一段（"记住偏好就直跳"）：用户在本站选过「走加速线路」之后，
  HTML 一解析到这段就跳去 blog.moxo.cc，不等主样式表、不等任何资源。
  只允许 moxo.cc → blog.moxo.cc 单向跳；反方向、预览域、API 路径、爬虫一律不管。
-->
<script is:inline>
  (() => {
    try {
      const LINE_PREF_KEY = 'moxo:line';

      const host = location.hostname;
      if (host !== 'moxo.cc' && host !== 'www.moxo.cc') return;
      if (navigator.webdriver) return;
      if (document.visibilityState === 'hidden') return;
      if (/bot|crawl|spider|slurp|bingpreview|facebookexternalhit|headless/i.test(navigator.userAgent)) return;
      if (location.pathname.startsWith('/api/')) return;
      if (localStorage.getItem(LINE_PREF_KEY) !== 'cdn') return;

      // 从加速域回到主域是用户的主动行为，别再把他弹回去
      const referrer = document.referrer || '';
      if (referrer.includes('//blog.moxo.cc')) return;

      location.replace('https://blog.moxo.cc' + location.pathname + location.search + location.hash);
    } catch {
      /* 隐私模式 / 存储被禁用：什么都不做，按普通访问处理 */
    }
  })();
</script>

<!--
  首屏关键样式，故意内联、不参与打包：加载层和页面底色在 HTML 解析到的当下就能画出来，
  不用等下面那两个几十 KB 的主样式表。主样式表在构建后会被
  scripts/defer-stylesheets.mjs 改成非阻塞加载（media="print" → 载入后切回 all），
  所以「白屏若干秒」会变成「一直在转圈」，等样式真的到位了加载层才撤。
-->
<style is:inline>
  html {
    background: #e8e4d9;
  }

  :root[data-theme='dark'] {
    background: #0d1413;
  }

  body {
    margin: 0;
  }

  .site-loader {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8e4d9;
    transition: opacity 0.5s ease, visibility 0s linear 0.5s;
  }

  .site-loader.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  :root[data-theme='dark'] .site-loader {
    background: #0d1413;
  }

  body.is-bare .site-loader {
    background: #080f10;
  }

  .site-loader-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.15rem;
  }

  .site-loader-mark {
    width: min(40vw, 136px);
    overflow: visible;
  }

  .site-loader path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sl-track {
    stroke: #1b4d5c;
    stroke-width: 2;
    opacity: 0.16;
  }

  .sl-trail {
    stroke: #1b4d5c;
    stroke-width: 2.5;
    animation: site-loader-trail 2s linear infinite;
    will-change: stroke-dashoffset;
  }

  .sl-trail--long {
    opacity: 0.22;
    stroke-dasharray: 0.34 0.66;
  }

  .sl-trail--mid {
    opacity: 0.55;
    stroke-dasharray: 0.16 0.84;
  }

  .sl-trail--head {
    stroke-width: 3;
    opacity: 0.95;
    stroke-dasharray: 0.045 0.955;
  }

  @keyframes site-loader-trail {
    to {
      stroke-dashoffset: -1;
    }
  }

  .site-loader-name {
    font-family: 'Songti SC', 'Noto Serif CJK SC', 'Source Han Serif SC', 'STSong', 'SimSun', serif;
    font-size: 0.8rem;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    text-transform: lowercase;
    color: #4a5652;
    opacity: 0.72;
  }

  :root[data-theme='dark'] .sl-track,
  :root[data-theme='dark'] .sl-trail {
    stroke: #79a7ad;
  }

  :root[data-theme='dark'] .sl-track {
    opacity: 0.22;
  }

  :root[data-theme='dark'] .site-loader-name {
    color: #b5b3a6;
  }

  body.is-bare .sl-track,
  body.is-bare .sl-trail {
    stroke: #79a7ad;
  }

  body.is-bare .site-loader-name {
    color: #8c948c;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-loader {
      transition: none;
    }

    .sl-trail {
      animation: none;
      stroke-dasharray: 1 0;
    }

    .sl-trail--long {
      opacity: 0;
    }

    .sl-trail--mid {
      opacity: 0.5;
    }

    .sl-trail--head {
      opacity: 0.9;
      stroke-width: 2.5;
    }
  }

  /* ── 慢线路提示条（方案 A）────────────────────────────────────
     和加载层一样必须内联：它出现的时候主样式表往往还没到。
     颜色全部写死，不依赖 global.css 里的 CSS 变量。 */
  .slow-line {
    position: fixed;
    left: 50%;
    bottom: 1.35rem;
    z-index: 2147483001;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    max-width: calc(100vw - 2rem);
    margin: 0;
    padding: 0.42rem 0.45rem 0.42rem 0.78rem;
    border: 1px solid rgba(27, 77, 92, 0.18);
    border-radius: 999px;
    background: rgba(239, 236, 227, 0.96);
    box-shadow: 0 12px 32px -20px rgba(0, 0, 0, 0.45);
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: #4a5652;
    transform: translateX(-50%) translateY(0.6rem);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .slow-line[hidden] {
    display: none;
  }

  .slow-line.is-on {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .slow-line-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2f7c8c;
  }

  .slow-line-text {
    white-space: nowrap;
  }

  .slow-line-text b {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: #222824;
  }

  .slow-line-sub {
    color: #7d857f;
  }

  .slow-line-go {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.34rem 0.68rem;
    border: 1px solid rgba(27, 77, 92, 0.42);
    border-radius: 999px;
    background: rgba(27, 77, 92, 0.08);
    color: #1b4d5c;
    font: inherit;
    letter-spacing: 0.03em;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .slow-line-go:hover {
    background: rgba(27, 77, 92, 0.16);
    border-color: rgba(27, 77, 92, 0.62);
  }

  .slow-line-close {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #7d857f;
    font: inherit;
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
  }

  .slow-line-close:hover {
    background: rgba(27, 77, 92, 0.1);
    color: #222824;
  }

  :root[data-theme='dark'] .slow-line {
    border-color: rgba(121, 167, 173, 0.24);
    background: rgba(18, 27, 25, 0.96);
    color: #b5b3a6;
  }

  :root[data-theme='dark'] .slow-line-text b {
    color: #e7e4da;
  }

  :root[data-theme='dark'] .slow-line-sub {
    color: #7f8a86;
  }

  :root[data-theme='dark'] .slow-line-dot {
    background: #79a7ad;
  }

  :root[data-theme='dark'] .slow-line-go {
    border-color: rgba(121, 167, 173, 0.5);
    background: rgba(121, 167, 173, 0.12);
    color: #9ec9cf;
  }

  :root[data-theme='dark'] .slow-line-go:hover {
    background: rgba(121, 167, 173, 0.22);
  }

  :root[data-theme='dark'] .slow-line-close {
    color: #7f8a86;
  }

  :root[data-theme='dark'] .slow-line-close:hover {
    background: rgba(121, 167, 173, 0.16);
    color: #e7e4da;
  }

  @media (max-width: 480px) {
    .slow-line {
      left: 0.9rem;
      right: 0.9rem;
      bottom: 1rem;
      max-width: none;
      transform: translateY(0.6rem);
      padding: 0.45rem 0.45rem 0.45rem 0.7rem;
      font-size: 0.68rem;
    }

    .slow-line.is-on {
      transform: translateY(0);
    }

    .slow-line-sub {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slow-line {
      transition: none;
    }
  }
</style>

<!-- 关掉 JS 时加载层永远没人撤，用 noscript 直接藏起来；主样式表的 noscript 兜底由构建脚本补。 -->
<noscript>
  <style is:inline>
    #site-loader {
      display: none !important;
    }
  </style>
</noscript>
