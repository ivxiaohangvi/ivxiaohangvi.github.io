---
import { siteConfig } from '../config';

const configuredHost = new URL(siteConfig.url).hostname.replace(/^www\./, '');
const siteHosts = [configuredHost, `www.${configuredHost}`].join(',');
---

<dialog
  id="external-gate"
  class="external-gate"
  data-site-hosts={siteHosts}
  data-pagefind-ignore
  aria-labelledby="external-gate-title"
  aria-describedby="external-gate-desc"
>
  <div class="external-gate-card">
    <div class="external-gate-head">
      <p class="external-gate-kicker">EXTERNAL / 站外链接</p>
      <button class="external-gate-close" type="button" data-external-action="stay" aria-label="关闭">
        ×
      </button>
    </div>
    <h2 class="external-gate-title" id="external-gate-title">即将离开本站</h2>
    <p class="external-gate-desc" id="external-gate-desc">
      该地址不属于 <span class="external-gate-site">{configuredHost}</span>，内容与安全性无法保证。
    </p>
    <p class="external-gate-dest">
      <span class="external-gate-host" data-external-host></span>
      <span class="external-gate-url" data-external-url></span>
    </p>
    <div class="external-gate-actions">
      <button class="external-gate-stay" type="button" data-external-action="stay">留在本站</button>
      <button class="external-gate-go" type="button" data-external-action="go">
        继续前往 <span aria-hidden="true">↗</span>
      </button>
    </div>
    <p class="external-gate-foot">只在你信任该来源时继续。</p>
  </div>
</dialog>

<script is:inline>
  (() => {
    if (window.__moxoExternalLinkGate) return;
    window.__moxoExternalLinkGate = true;

    const GATE_ID = 'external-gate';
    let pending = null;
    let trigger = null;

    const gateElement = () => document.getElementById(GATE_ID);

    const isExternalLink = (anchor) => {
      if (!(anchor instanceof HTMLAnchorElement)) return false;
      if (anchor.dataset.externalGate === 'off') return false;

      const rawHref = anchor.getAttribute('href');
      if (!rawHref || rawHref.startsWith('#')) return false;

      let url;
      try {
        url = new URL(anchor.href, location.href);
      } catch {
        return false;
      }
      if (url.protocol !== 'http:' && url.protocol !== 'https:') return false;

      const gate = gateElement();
      const configured = (gate?.dataset.siteHosts || '').split(',');
      const hosts = new Set();
      for (const host of [location.hostname, ...configured]) {
        const value = host.trim().toLowerCase();
        if (!value) continue;
        const bare = value.replace(/^www\./, '');
        hosts.add(bare);
        hosts.add(`www.${bare}`);
      }
      return !hosts.has(url.hostname.toLowerCase());
    };

    const bindGate = (gate) => {
      if (gate.dataset.externalBound === '1') return;
      gate.dataset.externalBound = '1';
      gate.addEventListener('close', () => {
        document.documentElement.classList.remove('is-external-gate-open');
        pending = null;
        const back = trigger;
        trigger = null;
        if (back && back.isConnected) back.focus({ preventScroll: true });
      });
      gate.addEventListener('cancel', () => {
        document.documentElement.classList.remove('is-external-gate-open');
      });
    };

    const openGate = (anchor, event) => {
      const gate = gateElement();
      if (!gate) return false;

      let url;
      try {
        url = new URL(anchor.href, location.href);
      } catch {
        return false;
      }

      bindGate(gate);
      pending = {
        href: url.href,
        newTab:
          anchor.target === '_blank' ||
          (Boolean(anchor.target) &&
            anchor.target !== '_self' &&
            anchor.target !== '_top' &&
            anchor.target !== '_parent') ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey,
      };
      trigger = anchor;

      gate.querySelector('[data-external-host]').textContent = url.host;
      gate.querySelector('[data-external-url]').textContent = url.href;

      if (!gate.open) {
        gate.showModal();
        document.documentElement.classList.add('is-external-gate-open');
      }
      const stay = gate.querySelector('.external-gate-stay');
      if (stay) stay.focus({ preventScroll: true });
      return true;
    };

    document.addEventListener(
      'click',
      (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        const target = event.target instanceof Element ? event.target : null;
        if (!target) return;

        const action = target.closest('[data-external-action]');
        if (action) {
          const gate = action.closest('dialog');
          if (!gate || gate.id !== GATE_ID) return;
          event.preventDefault();

          if (action.dataset.externalAction === 'go') {
            const destination = pending;
            pending = null;
            gate.close();
            if (!destination) return;
            if (destination.newTab) {
              window.open(destination.href, '_blank', 'noopener,noreferrer');
            } else {
              location.assign(destination.href);
            }
          } else {
            gate.close();
          }
          return;
        }

        const backdrop = target instanceof HTMLDialogElement ? target : null;
        if (backdrop && backdrop.id === GATE_ID) {
          backdrop.close();
          return;
        }

        const anchor = target.closest('a[href]');
        if (!anchor || anchor.closest(`#${GATE_ID}`) || !isExternalLink(anchor)) return;

        if (!gateElement()) return;
        event.preventDefault();
        event.stopPropagation();
        openGate(anchor, event);
      },
      true
    );

    document.addEventListener('astro:before-swap', () => {
      document.documentElement.classList.remove('is-external-gate-open');
      pending = null;
      trigger = null;
    });
  })();
</script>

<style>
  .external-gate {
    width: min(calc(100vw - 2rem), 29rem);
    max-width: 29rem;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--card);
    color: var(--ink);
    box-shadow:
      0 24px 70px rgba(4, 10, 9, 0.3),
      8px 8px 0 color-mix(in srgb, var(--ink) 8%, transparent);
    overflow-y: auto;
  }

  .external-gate::backdrop {
    background: rgba(6, 12, 11, 0.56);
    -webkit-backdrop-filter: blur(5px) saturate(0.9);
    backdrop-filter: blur(5px) saturate(0.9);
  }

  .external-gate[open] {
    animation: external-gate-in 0.22s var(--ease) both;
  }

  .external-gate-card {
    padding: 1.45rem 1.55rem 1.25rem;
    border-top: 3px solid var(--brass);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--brass) 5%, transparent),
      transparent 46%
    );
  }

  .external-gate-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .external-gate-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .external-gate-close {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 0;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .external-gate-close:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .external-gate-title {
    margin: 0.7rem 0 0;
    font-size: clamp(1.45rem, 4vw, 1.8rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .external-gate-desc {
    margin: 0.55rem 0 0;
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--ink-soft);
  }

  .external-gate-site {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .external-gate-dest {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    min-width: 0;
    margin: 1.1rem 0 0;
    padding: 0.68rem 0.8rem 0.62rem;
    border: 1px solid var(--rule);
    border-left: 2px solid var(--brass);
    background: color-mix(in srgb, var(--paper) 68%, transparent);
  }

  .external-gate-host {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .external-gate-url {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    line-height: 1.5;
    color: var(--muted);
    direction: ltr;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .external-gate-actions {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.2rem;
  }

  .external-gate-actions button {
    padding: 0.58rem 0.95rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.76rem;
    line-height: 1.2;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .external-gate-stay:hover {
    border-color: var(--brass);
    color: var(--brass);
  }

  .external-gate-go {
    background: var(--ink);
    color: var(--paper);
  }

  .external-gate-go:hover {
    background: var(--brass);
    border-color: var(--brass);
    color: var(--paper);
  }

  .external-gate-actions button:focus-visible,
  .external-gate-close:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
  }

  .external-gate-foot {
    margin: 0.85rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-align: right;
  }

  :global(html.is-external-gate-open) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  /* showModal 的 top layer 会盖住页面的准星；弹层期间交还原生光标 */
  :global(html.has-cursor-mark .external-gate[open]),
  :global(html.has-cursor-mark .external-gate[open] *) {
    cursor: auto !important;
  }

  :global(html.has-cursor-mark .external-gate[open] button) {
    cursor: pointer !important;
  }

  @keyframes external-gate-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .external-gate {
      inset: auto 0 0;
      width: 100%;
      max-width: none;
      max-height: calc(100dvh - 1rem);
      margin: 0;
      border-right: 0;
      border-bottom: 0;
      border-left: 0;
      box-shadow: 0 -18px 50px rgba(4, 10, 9, 0.3);
    }

    .external-gate-card {
      padding: 1.3rem 1.15rem calc(1.15rem + env(safe-area-inset-bottom));
    }

    .external-gate-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .external-gate-actions button {
      padding-block: 0.72rem;
    }

    .external-gate-foot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .external-gate[open] {
      animation: none;
    }
  }
</style>
