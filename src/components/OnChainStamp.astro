---
/**
 * 文章底部的「蓝晒存证 / 引用声明」。
 *
 * 合并了原来的「引用声明」与「已上链提示」：一条描图纸风格的卡片，
 * 左上角蓝晒徽标里的小圆点就是 OTS 状态灯。
 *
 * 数据来自 src/data/ots.json（由 scripts/ots-stamp.mjs 生成，跟着构建产物一起提交）。
 * 状态如实区分，绝不把没确认的写成已确认：
 *   confirmed  证明已绑到某个比特币区块 —— 青色灯，给高度 / 哈希 / 出块时间
 *   pending    已提交日历，还没进区块（通常 1–24 小时）—— 铜色灯，只写等待
 *   stale      构建时发现内容指纹与清单对不上（正文改过但没重新盖章）—— 红色灯，标「旧证明」
 *   missing    还没有存证记录 —— 不显示存证信息，只保留引用声明与复制声明
 */
import { createHash } from 'node:crypto';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import ots from '../data/ots.json';

interface Props {
  slug: string;
  title: string;
  date: Date;
  url: string;
}

const { slug, title, date, url } = Astro.props;

const item = (ots.items as Record<string, any>)[slug];
const explorer: string = ots.explorer ?? 'https://mempool.space';

/** 指纹以磁盘上的 .txt 为准：它才是被盖章的那份字节 */
function currentDigest(path: string): string | null {
  try {
    const file = join(process.cwd(), 'public', path.replace(/^\//, ''));
    if (!existsSync(file)) return null;
    return createHash('sha256').update(readFileSync(file)).digest('hex');
  } catch {
    return null;
  }
}

const digest = item ? currentDigest(item.content) : null;
const stale = Boolean(item && digest && item.digest && digest !== item.digest);
const status = !item ? 'missing' : stale ? 'stale' : item.status;
const hasChain = status !== 'missing';

const short = (hex: string | null | undefined, head = 10, tail = 6) =>
  hex ? `${hex.slice(0, head)}…${hex.slice(-tail)}` : '—';

/** 区块哈希：前 6 位 + 后 16 位，方便肉眼核对 */
const shortHash = (hex: string | null | undefined) => (hex ? `${hex.slice(0, 6)}…${hex.slice(-16)}` : '—');

const beijing = (iso: string | null | undefined) => {
  if (!iso) return '—';
  const d = new Date(iso);
  const parts = new Intl.DateTimeFormat('zh-CN', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(d);
  const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
  return `${get('year')}-${get('month')}-${get('day')} ${get('hour')}:${get('minute')}`;
};

const dateText = (value: Date) => {
  const parts = new Intl.DateTimeFormat('zh-CN', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).formatToParts(value);
  const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
  return `${get('year')}-${get('month')}-${get('day')}`;
};

const author = '背井离江的汤姆（ivxiaohangvi）';
const dateStr = dateText(date);
const heightText = item?.height ? Number(item.height).toLocaleString('en-US') : '';
const blockHref = item?.explorer ?? (item?.blockHash ? `${explorer}/block/${item.blockHash}` : null);

const stateLabel: Record<string, string> = {
  confirmed: '蓝晒存证 · OTS 已上链',
  pending: '蓝晒存证 · OTS 待确认',
  stale: '蓝晒存证 · OTS 已过期',
  missing: '引用声明 · 尚未存证',
};

const copyText = [`${author} · moxo.cc · ${dateStr}`, `《${title}》`, `原文链接：${url}`].join('\n');

const lead = '本文由背井离江的汤姆（ivxiaohangvi）发布于 moxo.cc 个人博客，';
const bodyHtml =
  status === 'confirmed'
    ? `${lead}<span class="nw">文章发布指纹已锚定于比特币主链，</span><span class="nw">区块高度为 <b>#${heightText}</b>。</span>`
    : status === 'stale'
      ? `${lead}<span class="nw">文章发布指纹原锚定于比特币主链，</span><span class="nw">区块高度为 <b>#${heightText}</b>，</span>但正文已变更、存证已过期。`
      : status === 'pending'
        ? `${lead}文章发布指纹已提交 OpenTimestamps 存证，正在等待写入比特币主链。`
        : lead;

const licenseText = '本文仅允许在充分声明原文链接或作者的情况下进行引用、摘要、传播，禁止商用分发传播。';
const legalText =
  '本文内容出于对技术方法学习的交流探讨为目的，内容中可能涉及到的知识产权等内容归其所有者所有，本文发布者不对本文内容安全性、真实性做担保承诺，使用者需自行验证信息准确性，如因使用本文提到的任何内容导致的任何纠纷（如违反厂商服务条款，侵犯知识产权等），由使用者自行承担，发布方概不负责。';

const REG_SVG =
  '<svg class="reg-mark" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="0.9"/><line x1="12" y1="1" x2="12" y2="7"/><line x1="12" y1="17" x2="12" y2="23"/><line x1="1" y1="12" x2="7" y2="12"/><line x1="17" y1="12" x2="23" y2="12"/></svg>';
---

<section
  class:list={['onchain', `is-${status}`]}
  data-pagefind-ignore
  aria-label="蓝晒存证与引用声明"
>
  <span class="cy-reg tl" aria-hidden="true" set:html={REG_SVG} />
  <span class="cy-reg tr" aria-hidden="true" set:html={REG_SVG} />
  <span class="cy-reg bl" aria-hidden="true" set:html={REG_SVG} />
  <span class="cy-reg br" aria-hidden="true" set:html={REG_SVG} />

  <div class="cy-top">
    <span class:list={['cy-badge', hasChain && `cy-badge--${status}`]} title={stateLabel[status]}>
      {hasChain && <span class="cy-dot" aria-hidden="true" />}
      BLUEPRINT / {hasChain ? '蓝晒存证' : '引用声明'}
    </span>
    <span class="cy-spacer" />
    {
      hasChain && (
        <span class="cy-digest">
          <span class="k">SHA-256</span>
          <code>{short(item?.digest ?? digest, 12, 8)}</code>
        </span>
      )
    }
  </div>

  <div class="cy-body">
    <p set:html={bodyHtml}></p>

    <div class="cy-legal">
      <p class="cy-legal-para">
        <span class="cy-legal-clamp">{licenseText}<br />{legalText}</span>
      </p>
      <button class="cy-legal-toggle" type="button" aria-expanded="false">展开</button>
    </div>
  </div>

  <div class="cy-foot">
    {
      hasChain && (
        <span class="cy-foot-meta">
          {status === 'pending' ? (
            <>
              <span class="k">BLOCK</span>
              <span>等待打包</span>
              <span class="cy-sep">·</span>
              <span>已提交 OpenTimestamps 日历，通常 1–24 小时后写入比特币区块</span>
            </>
          ) : (
            <>
              <span class="k">BLOCK</span>
              <span>#{heightText}</span>
              <span class="cy-sep">·</span>
              <span>{shortHash(item?.blockHash)}</span>
              <span class="cy-sep">·</span>
              <span>{beijing(item?.blockTime)}</span>
              {status === 'stale' && (
                <>
                  <span class="cy-sep">·</span>
                  <span class="cy-stale-mark">（旧证明）</span>
                </>
              )}
            </>
          )}
        </span>
      )
    }
    <span class="cy-spacer" />
    <span class="cy-foot-actions">
      {item?.content && <a href={item.content} download>内容 .txt ↓</a>}
      {item?.stamp && <a href={item.stamp} download>证明 .ots ↓</a>}
      {
        hasChain && status !== 'pending' && blockHref && (
          <a href={blockHref} target="_blank" rel="noopener noreferrer">查看区块 ↗</a>
        )
      }
      <button
        class="cy-copy"
        type="button"
        data-copy={copyText}
        title="复制引用声明（作者、标题与原文链接）"
      >
        <span class="cy-copy-label">复制声明</span>
        <svg class="cy-ico" viewBox="0 0 12 12" aria-hidden="true">
          <rect x="3.9" y="1.1" width="5.9" height="6.8" rx="0.7"></rect>
          <path d="M8.1 10.9H2.2V4.1"></path>
        </svg>
      </button>
    </span>
  </div>

  <div class="cy-license">
    <span class="k">LICENSE</span>
    <a
      href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans"
      target="_blank"
      rel="noopener noreferrer">本作品采用 CC BY-NC-SA 4.0 许可协议（署名-非商业性使用-相同方式共享 4.0 国际）</a
    >
  </div>
</section>

<script>
  const copyTextToClipboard = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      try {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        const ok = document.execCommand('copy');
        area.remove();
        return ok;
      } catch {
        return false;
      }
    }
  };

  document.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;

    const copyButton = target.closest('.onchain .cy-copy') as HTMLButtonElement | null;
    if (copyButton) {
      const ok = await copyTextToClipboard(copyButton.dataset.copy ?? '');
      const label = copyButton.querySelector<HTMLElement>('.cy-copy-label');
      if (!label) return;
      if (copyButton.dataset.label === undefined) {
        copyButton.dataset.label = label.textContent ?? '复制声明';
      }
      label.textContent = ok ? '已复制' : '复制失败';
      copyButton.classList.toggle('is-copied', ok);
      window.clearTimeout(Number(copyButton.dataset.timer ?? 0));
      copyButton.dataset.timer = String(
        window.setTimeout(() => {
          label.textContent = copyButton.dataset.label ?? '复制声明';
          copyButton.classList.remove('is-copied');
        }, 1600),
      );
      return;
    }

    const toggle = target.closest('.onchain .cy-legal-toggle') as HTMLButtonElement | null;
    if (!toggle) return;
    const wrap = toggle.closest('.cy-legal') as HTMLElement | null;
    if (!wrap) return;
    const open = wrap.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = open ? '收起' : '展开';
  });
</script>
