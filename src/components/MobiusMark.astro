---
interface Props {
  class?: string;
  strokeWidth?: number;
  showDot?: boolean;
}

const { class: className = '', strokeWidth = 2, showDot = true } = Astro.props;
---
<svg class={className} viewBox="0 0 80 48" fill="none" aria-hidden="true">
  <path
    d="M8 24C8 10 28 8 40 24C52 40 72 38 72 24C72 10 52 8 40 24C28 40 8 38 8 24Z"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  {showDot && <circle class="mobius-dot" cx="40" cy="24" r="2.2" fill="currentColor"></circle>}
</svg>
