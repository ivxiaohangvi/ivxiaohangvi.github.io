---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { buildWordField } from '../../lib/word-field';
import { layoutWordCloud } from '../../lib/word-cloud-layout';
import { beijingMonthDay } from '../../lib/date';
import WordDriftCloud from '../../components/WordDriftCloud.astro';
import '../../styles/word-field.css';

const [diary, moments, blog] = await Promise.all([
  getCollection('diary'),
  getCollection('moments'),
  getCollection('blog', ({ data }) => !data.draft),
]);
const field = buildWordField([...diary, ...moments, ...blog]);
const words = field.words;
const note = `${field.sourceCount} 篇公开记录 · ${words.length} 个词`;

const rotations = [-3.4, 2.2, -1.4, 3.1, -2.4, 1.1, 2.8, -0.8];
const lifts = ['0.14rem', '-0.08rem', '0.22rem', '-0.18rem', '0.04rem', '-0.12rem'];

const driftDesktop = layoutWordCloud(words, {
  width: 720,
  height: 400,
  sizes: { 1: 60, 2: 44, 3: 33, 4: 24 },
  padding: 8,
  gap: 9,
  seed: 23757,
  shape: 3.2,
  bands: { 1: [0.02, 0.28], 2: [0.26, 0.56], 3: [0.5, 0.8], 4: [0.7, 0.97] },
});
const driftMobile = layoutWordCloud(words, {
  width: 360,
  height: 520,
  sizes: { 1: 44, 2: 33, 3: 26, 4: 20 },
  padding: 5,
  gap: 8,
  seed: 2718,
  shape: 3.2,
  bands: { 1: [0.02, 0.38], 2: [0.24, 0.62], 3: [0.44, 0.82], 4: [0.62, 1.0] },
  ampScale: 0.8,
});

const captions: Record<string, string> = {
  index: '词目：把词排成书末索引，用点线连到出现次数。最安静，最好扫读。',
  case: '字盘：6 × 6 活字格，每格一词、一角标数。最有版面结构，像一间活字车间。',
  poem: '词句：把 36 个词连成一段话，右上角的小字是出现篇数。最像文字本身。',
  cloud: '云团：把词放大、居中、加一点倾角。最像云，但离现状也最近。',
  drift: '沉浮：词在墨色里缓慢上浮、下沉，像一些念头浮出水面又沉回去。',
};
---

<BaseLayout title="词场外观试验" description="moxo 词场的四种外观方向。" noindex>
  <div class="wrap-narrow lab">
    <header class="page-head lab-head">
      <p class="eyebrow">SEARCH LAB / 词场</p>
      <div class="page-head-line">
        <h1>词场外观试验</h1>
      </div>
      <p class="page-lede">五种方向：三种换读法，一种静态云团，一种动态沉浮。切换对比，悬停看词频，点词试搜索。</p>
    </header>

    <div class="lab-bar">
      <div class="lab-tabs" role="tablist" aria-label="词场外观方案">
        <button type="button" role="tab" id="tab-index" aria-controls="panel-index" aria-selected="true" data-lab-tab="index">一 · 词目</button>
        <button type="button" role="tab" id="tab-case" aria-controls="panel-case" aria-selected="false" data-lab-tab="case">二 · 字盘</button>
        <button type="button" role="tab" id="tab-poem" aria-controls="panel-poem" aria-selected="false" data-lab-tab="poem">三 · 词句</button>
        <button type="button" role="tab" id="tab-cloud" aria-controls="panel-cloud" aria-selected="false" data-lab-tab="cloud">四 · 云团</button>
        <button type="button" role="tab" id="tab-drift" aria-controls="panel-drift" aria-selected="false" data-lab-tab="drift">五 · 沉浮</button>
      </div>
      <span class="lab-hint">点击切换</span>
    </div>

    <p class="lab-caption" data-caption>{captions.index}</p>

    <div class="search-box lab-search">
      <label class="search-label" for="search-input">关键词（示意）</label>
      <input id="search-input" type="search" placeholder="比如：莫比乌斯、摄影、深夜…" autocomplete="off" spellcheck="false" />
      <p class="search-hint" id="lab-hint">点击任意一个词，会填入这里。</p>
    </div>

    <div class="lab-stage">
      <section class="lab-panel" id="panel-index" role="tabpanel" aria-labelledby="tab-index" data-panel="index">
        <div class="wf-head">
          <b>词目 / INDEX OF WORDS</b>
          <span class="wf-note" data-note>{note}</span>
        </div>
        <ol class="wf-index-list">
          {words.map((item, index) => (
            <li>
              <a
                href={`/search/?q=${encodeURIComponent(item.word)}`}
                data-word={item.word}
                data-count={item.count}
                data-last={item.lastSeen ? beijingMonthDay(item.lastSeen) : ''}
                aria-label={`用「${item.word}」搜索`}
              >
                <span class="wf-idx">{String(index + 1).padStart(2, '0')}</span>
                <span class="wf-word">{item.word}</span>
                <span class="wf-leader" aria-hidden="true"></span>
                <span class="wf-count">{item.count}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="lab-panel" id="panel-case" role="tabpanel" aria-labelledby="tab-case" data-panel="case" hidden>
        <div class="wf-head">
          <b>字盘 / TYPE CASE</b>
          <span class="wf-note" data-note>{note}</span>
        </div>
        <ol class="wf-case-grid">
          {words.map((item) => (
            <li class={`is-t${item.tier}`} style={`--fade:${item.fade}`}>
              <a
                href={`/search/?q=${encodeURIComponent(item.word)}`}
                data-word={item.word}
                data-count={item.count}
                data-last={item.lastSeen ? beijingMonthDay(item.lastSeen) : ''}
                aria-label={`用「${item.word}」搜索`}
              >
                <span class="wf-case-count">{item.count}</span>
                <span class="wf-case-word">{item.word}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="lab-panel" id="panel-poem" role="tabpanel" aria-labelledby="tab-poem" data-panel="poem" hidden>
        <div class="wf-head">
          <b>词句 / FOUND TEXT</b>
          <span class="wf-note" data-note>{note}</span>
        </div>
        <p class="wf-poem">
          {words.map((item, index) => (
            <>
              <span class="wf-piece">
                <a
                  href={`/search/?q=${encodeURIComponent(item.word)}`}
                  class={`is-t${item.tier}`}
                  data-word={item.word}
                  data-count={item.count}
                  data-last={item.lastSeen ? beijingMonthDay(item.lastSeen) : ''}
                  aria-label={`用「${item.word}」搜索`}
                >
                  {item.word}<sup>{item.count}</sup>
                </a>
                {index < words.length - 1 ? <span class="wf-sep" aria-hidden="true">、</span> : <span class="wf-end" aria-hidden="true">。</span>}
              </span>
              {index < words.length - 1 && <wbr />}
            </>
          ))}
        </p>
        <p class="wf-sign">—— 由 {field.sourceCount} 篇公开记录里出现三次以上的词写成</p>
      </section>

      <section class="lab-panel" id="panel-cloud" role="tabpanel" aria-labelledby="tab-cloud" data-panel="cloud" hidden>
        <div class="wf-head">
          <b>云团 / CLOUD</b>
          <span class="wf-note" data-note>{note}</span>
        </div>
        <ul class="wf-cloud">
          {words.map((item, index) => (
            <li
              class={`is-t${item.tier}`}
              style={`--fade:${item.fade};--r:${rotations[index % rotations.length]}deg;--dy:${lifts[index % lifts.length]}`}
            >
              <a
                href={`/search/?q=${encodeURIComponent(item.word)}`}
                data-word={item.word}
                data-count={item.count}
                data-last={item.lastSeen ? beijingMonthDay(item.lastSeen) : ''}
                aria-label={`用「${item.word}」搜索`}
              >
                {item.word}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="lab-panel" id="panel-drift" role="tabpanel" aria-labelledby="tab-drift" data-panel="drift" hidden>
        <div class="wf-head">
          <b>沉浮 / DRIFT</b>
          <span class="wf-note" data-note>{note}</span>
        </div>
        <div class="wc-stage">
          <WordDriftCloud layout={driftDesktop} variant="desktop" />
          <WordDriftCloud layout={driftMobile} variant="mobile" />
        </div>
      </section>
    </div>

    <p class="lab-foot">试验页，不参与索引。当前版本在 <a href="/search/">/search/</a>；选定后把其中一套接回去。</p>
  </div>
</BaseLayout>

<style>
  .lab {
    padding-top: 2.3rem;
  }

  .lab-head h1 {
    font-size: clamp(2.2rem, 5vw, 3rem);
  }

  .lab-head .page-lede {
    max-width: 34em;
  }

  .lab-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 0.45rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .lab-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem;
  }

  .lab-tabs button {
    position: relative;
    appearance: none;
    padding: 0.38rem 0.62rem;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  /* 页签只有 59×27，手机上容易点空：纵向垫到 44px（横向已在 44 以上），
     扩出来的部分落在 .lab-bar 的 padding 里，不影响排版 */
  .lab-tabs button::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: max(100%, 44px);
    translate: 0 -50%;
  }

  .lab-tabs button:hover {
    color: var(--ink);
  }

  .lab-tabs button[aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--brass);
  }

  .lab-hint {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    white-space: nowrap;
  }

  .lab-caption {
    min-height: 3.2em;
    margin: 0.9rem 0 0;
    font-family: var(--font-display);
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--ink-soft);
  }

  .lab-search {
    margin-top: 0.9rem;
  }

  .lab-search .search-hint {
    font-size: 0.68rem;
  }

  .lab-stage {
    min-height: 28rem;
    padding-bottom: 1rem;
  }

  .lab-panel[hidden] {
    display: none;
  }

  .lab-foot {
    margin: 1.4rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px solid var(--rule-soft);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .lab-foot a {
    color: var(--brass);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--brass) 45%, transparent);
    text-underline-offset: 0.2em;
  }

  .wf-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.8rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.16em;
    color: var(--muted);
  }

  .wf-head b {
    font-weight: 400;
    color: var(--brass);
    white-space: nowrap;
  }

  .wf-note {
    line-height: 1.6;
    text-align: right;
    white-space: nowrap;
  }

  /* 一 · 词目 ------------------------------------------------------------- */
  .wf-index-list {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    columns: 3;
    column-gap: clamp(1.2rem, 3.5vw, 2.4rem);
  }

  .wf-index-list li {
    break-inside: avoid;
  }

  .wf-index-list a {
    display: flex;
    align-items: baseline;
    gap: 0.42rem;
    padding: 0.16rem 0.2rem;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.16s ease, background-color 0.16s ease;
  }

  .wf-idx {
    flex: none;
    width: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.46rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    opacity: 0.55;
  }

  .wf-word {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.6;
    white-space: nowrap;
  }

  .wf-leader {
    flex: 1;
    min-width: 0.5rem;
    border-bottom: 1px dotted var(--rule);
    transform: translateY(-0.18em);
  }

  .wf-count {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .wf-index-list a:hover,
  .wf-index-list a:focus-visible {
    color: var(--brass);
    background: color-mix(in srgb, var(--brass-soft) 12%, transparent);
  }

  .wf-index-list a:hover .wf-word,
  .wf-index-list a:hover .wf-count,
  .wf-index-list a:focus-visible .wf-word,
  .wf-index-list a:focus-visible .wf-count {
    color: var(--brass);
  }

  /* 二 · 字盘 ------------------------------------------------------------- */
  .wf-case-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--rule);
  }

  .wf-case-grid li {
    display: flex;
    min-height: 3.9rem;
    border-right: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
  }

  .wf-case-grid li:nth-child(6n) {
    border-right: 0;
  }

  .wf-case-grid li:nth-last-child(-n + 6) {
    border-bottom: 0;
  }

  .wf-case-grid a {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    padding: 0.5rem 0.55rem 0.45rem;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.18s ease, color 0.18s ease;
  }

  .wf-case-count {
    position: absolute;
    top: 0.34rem;
    right: 0.44rem;
    font-family: var(--font-mono);
    font-size: 0.44rem;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .wf-case-word {
    font-family: var(--font-display);
    font-size: 0.92rem;
    line-height: 1.15;
    opacity: var(--fade);
  }

  .wf-case-grid .is-t1 .wf-case-word {
    font-size: 1.55rem;
    font-weight: 600;
  }

  .wf-case-grid .is-t2 .wf-case-word {
    font-size: 1.22rem;
  }

  .wf-case-grid .is-t3 .wf-case-word {
    font-size: 1.02rem;
  }

  .wf-case-grid a:hover,
  .wf-case-grid a:focus-visible {
    background: var(--card);
  }

  .wf-case-grid a:hover .wf-case-word,
  .wf-case-grid a:hover .wf-case-count,
  .wf-case-grid a:focus-visible .wf-case-word,
  .wf-case-grid a:focus-visible .wf-case-count {
    color: var(--brass);
  }

  /* 三 · 词句 ------------------------------------------------------------- */
  .wf-poem {
    margin: 1.2rem 0 0;
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 2.1;
    color: var(--ink);
    letter-spacing: 0.01em;
  }

  .wf-piece {
    white-space: nowrap;
  }

  .wf-poem a {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.16s ease;
  }

  .wf-poem a.is-t1 {
    font-size: 1.7rem;
    font-weight: 600;
  }

  .wf-poem a.is-t2 {
    font-size: 1.32rem;
  }

  .wf-poem a.is-t3 {
    font-size: 1.12rem;
  }

  .wf-poem a.is-t4 {
    font-size: 1rem;
  }

  .wf-poem a:hover,
  .wf-poem a:focus-visible {
    color: var(--brass);
  }

  .wf-poem sup {
    margin-left: 0.06em;
    font-family: var(--font-mono);
    font-size: 0.42rem;
    font-weight: 400;
    line-height: 0;
    letter-spacing: 0;
    color: var(--muted);
    vertical-align: super;
  }

  .wf-poem a:hover sup,
  .wf-poem a:focus-visible sup {
    color: var(--brass);
  }

  .wf-sep {
    font-size: 0.86em;
    color: var(--muted);
    opacity: 0.55;
  }

  .wf-end {
    color: var(--brass);
  }

  .wf-sign {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.12em;
    line-height: 1.8;
    color: var(--muted);
  }

  /* 四 · 云团 ------------------------------------------------------------- */
  .wf-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.12em 0.9em;
    margin: 1.3rem 0 0;
    padding: 0.8rem 0 1.2rem;
    list-style: none;
    line-height: 1.2;
  }

  .wf-cloud li {
    transform: rotate(var(--r)) translateY(var(--dy));
    opacity: var(--fade);
    transition: opacity 0.22s ease, transform 0.28s var(--ease);
  }

  .wf-cloud a {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.12rem;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .wf-cloud .is-t1 a {
    font-size: clamp(2rem, 4.6vw, 2.55rem);
    font-weight: 600;
  }

  .wf-cloud .is-t2 a {
    font-size: clamp(1.55rem, 3.3vw, 1.9rem);
  }

  .wf-cloud .is-t3 a {
    font-size: clamp(1.25rem, 2.5vw, 1.46rem);
  }

  .wf-cloud .is-t4 a {
    font-size: clamp(1.02rem, 2vw, 1.16rem);
  }

  .wf-cloud li:hover,
  .wf-cloud li:focus-within {
    opacity: 1;
    transform: rotate(0deg) translateY(var(--dy)) scale(1.04);
  }

  .wf-cloud a:hover,
  .wf-cloud a:focus-visible {
    color: var(--brass);
  }

  /* 五 · 沉浮 ------------------------------------------------------------- */
  .wc-stage {
    margin-top: 1rem;
  }

  @media (max-width: 560px) {
    .lab {
      padding-top: 1.6rem;
    }

    .lab-head h1 {
      font-size: 2rem;
    }

    .lab-bar {
      gap: 0.5rem;
    }

    .lab-tabs button {
      padding: 0.34rem 0.44rem;
      font-size: 0.55rem;
      letter-spacing: 0.06em;
    }

    .lab-hint {
      display: none;
    }

    .lab-caption {
      font-size: 0.82rem;
      min-height: 4.8em;
    }

    .wf-head {
      gap: 0.8rem;
      font-size: 0.5rem;
      letter-spacing: 0.12em;
    }

    .wf-note {
      font-size: 0.48rem;
    }

    .wf-index-list {
      columns: 3;
      column-gap: 0.7rem;
    }

    .wf-index-list a {
      gap: 0.3rem;
      padding: 0.15rem 0.12rem;
    }

    .wf-idx,
    .wf-leader {
      display: none;
    }

    .wf-word {
      font-size: 0.9rem;
    }

    .wf-case-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .wf-case-grid li {
      min-height: 3.15rem;
    }

    .wf-case-grid li:nth-child(6n) {
      border-right: 1px solid var(--rule-soft);
    }

    .wf-case-grid li:nth-child(4n) {
      border-right: 0;
    }

    .wf-case-grid li:nth-last-child(-n + 6) {
      border-bottom: 1px solid var(--rule-soft);
    }

    .wf-case-grid li:nth-last-child(-n + 4) {
      border-bottom: 0;
    }

    .wf-case-grid a {
      padding: 0.4rem 0.4rem 0.35rem;
    }

    .wf-case-grid .is-t1 .wf-case-word {
      font-size: 1.26rem;
    }

    .wf-case-grid .is-t2 .wf-case-word {
      font-size: 1.06rem;
    }

    .wf-case-grid .is-t3 .wf-case-word {
      font-size: 0.94rem;
    }

    .wf-case-word {
      font-size: 0.86rem;
    }

    .wf-poem {
      font-size: 1rem;
      line-height: 2;
    }

    .wf-poem a.is-t1 {
      font-size: 1.45rem;
    }

    .wf-poem a.is-t2 {
      font-size: 1.18rem;
    }

    .wf-poem a.is-t3 {
      font-size: 1.04rem;
    }

    .wf-poem a.is-t4 {
      font-size: 0.94rem;
    }

    .wf-cloud {
      gap: 0.1em 0.72em;
      padding-top: 0.4rem;
    }

    .wf-cloud .is-t1 a {
      font-size: 1.85rem;
    }

    .wf-cloud .is-t2 a {
      font-size: 1.48rem;
    }

    .wf-cloud .is-t3 a {
      font-size: 1.2rem;
    }

    .wf-cloud .is-t4 a {
      font-size: 1rem;
    }
  }
</style>

<script>
  const captions: Record<string, string> = {
    index: '词目：把词排成书末索引，用点线连到出现次数。最安静，最好扫读。',
    case: '字盘：6 × 6 活字格，每格一词、一角标数。最有版面结构，像一间活字车间。',
    poem: '词句：把 36 个词连成一段话，右上角的小字是出现篇数。最像文字本身。',
    cloud: '云团：把词放大、居中、加一点倾角。最像云，但离现状也最近。',
    drift: '沉浮：词在墨色里缓慢上浮、下沉，像一些念头浮出水面又沉回去。',
  };

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lab-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const caption = document.querySelector<HTMLElement>('[data-caption]');

  const select = (name: string): void => {
    if (!captions[name]) return;
    tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.labTab === name)));
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.panel !== name;
    });
    if (caption) caption.textContent = captions[name];
    if (location.hash !== `#${name}`) history.replaceState(null, '', `#${name}`);
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => select(tab.dataset.labTab ?? 'index'));
  });

  let initial = location.hash.slice(1);
  if (!captions[initial]) initial = 'index';
  select(initial);

  document.addEventListener('keydown', (event) => {
    if ((event.target as HTMLElement)?.matches('input, textarea')) return;
    const map: Record<string, string> = { '1': 'index', '2': 'case', '3': 'poem', '4': 'cloud', '5': 'drift' };
    if (map[event.key]) select(map[event.key]);
  });

  const input = document.querySelector<HTMLInputElement>('#search-input');
  const hint = document.querySelector<HTMLElement>('#lab-hint');
  const hintDefault = hint?.textContent ?? '';

  panels.forEach((panel) => {
    const note = panel.querySelector<HTMLElement>('[data-note]');
    if (!note) return;
    const base = note.textContent ?? '';
    panel.querySelectorAll<HTMLAnchorElement>('a[data-word]').forEach((link) => {
      const show = (): void => {
        const last = link.dataset.last ? ` · 最近 ${link.dataset.last}` : '';
        note.textContent = `「${link.dataset.word}」${link.dataset.count} 篇${last}`;
      };
      const reset = (): void => {
        note.textContent = base;
      };
      link.addEventListener('pointerenter', show);
      link.addEventListener('focus', show);
      link.addEventListener('pointerleave', reset);
      link.addEventListener('blur', reset);
      link.addEventListener('click', (event) => {
        event.preventDefault();
        if (!input || !hint) return;
        input.value = link.dataset.word ?? '';
        input.focus();
        hint.textContent = `示意：将以「${input.value}」搜索，命中 ${link.dataset.count} 篇。真实页面里词场会在这一刻收起。`;
      });
    });
  });

  input?.addEventListener('input', () => {
    if (!input.value.trim() && hint) hint.textContent = hintDefault;
  });
</script>
