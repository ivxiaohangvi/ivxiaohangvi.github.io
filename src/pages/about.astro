  <AsoulPeek />
</BaseLayout>

<script>
  import '../scripts/steam-status';

  function initClock() {
    const node = document.querySelector<HTMLElement>('[data-clock]');
    const pushes = Array.from(document.querySelectorAll<HTMLElement>('[data-push-time]'));

    // 推送行给的是绝对时间，脚本在就换成「N 小时前」；每秒重算太浪费，按分钟刷。
    const relative = (iso: string, now: number) => {
      const at = Date.parse(iso);
      if (!Number.isFinite(at)) return '';
      const minutes = Math.round((now - at) / 60000);
      if (minutes < 1) return '刚刚';
      if (minutes < 60) return `${minutes} 分钟前`;
      const hours = Math.round(minutes / 60);
      if (hours < 24) return `${hours} 小时前`;
      const days = Math.round(hours / 24);
      if (days < 30) return `${days} 天前`;
      return new Date(at)
        .toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' })
        .replace(/\//g, '.');
    };

    const paintPushes = (now: number) => {
      for (const item of pushes) {
        const iso = item.dataset.iso;
        if (!iso) continue;
        const text = relative(iso, now);
        if (text) item.textContent = text;
      }
    };

    let lastMinute = -1;
    const tick = () => {
      const now = new Date();
      if (node) {
        const parts = new Intl.DateTimeFormat('zh-CN', {
          timeZone: 'Asia/Shanghai',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hourCycle: 'h23',
        }).formatToParts(now);
        const get = (type: string) => parts.find((part) => part.type === type)?.value ?? '00';
        node.textContent = `${get('hour')}:${get('minute')}:${get('second')}`;
      }
      const minute = Math.floor(now.getTime() / 60000);
      if (minute !== lastMinute) {
        lastMinute = minute;
        paintPushes(now.getTime());
      }
    };
    tick();
    window.clearInterval((window as unknown as { __aboutClock?: number }).__aboutClock);
    (window as unknown as { __aboutClock?: number }).__aboutClock = window.setInterval(tick, 1000);
  }

  function initIndex() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-index-link]'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-index-section]'));
    if (!links.length || !sections.length) return;

    const setActive = (id: string) => {
      links.forEach((link) => {
        if (link.dataset.indexLink === id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive((visible[0].target as HTMLElement).id);
      },
      { rootMargin: '-15% 0px -65% 0px', threshold: 0 }
    );
    sections.forEach((section) => observer.observe(section));
    setActive(sections[0].id);
  }

  function initCopy() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      if (button.dataset.copyReady === '1') return;
      button.dataset.copyReady = '1';
      button.addEventListener('click', async () => {
        const value = button.dataset.copy ?? '';
        if (!value) return;
        const original = button.textContent ?? '复制';
        let copied = false;
        try {
          await navigator.clipboard.writeText(value);
          copied = true;
        } catch {
          const field = document.createElement('textarea');
          field.value = value;
          field.setAttribute('readonly', '');
          field.style.position = 'fixed';
          field.style.top = '-1000px';
          field.style.opacity = '0';
          document.body.appendChild(field);
          field.select();
          try {
            copied = document.execCommand('copy');
          } catch {
            copied = false;
          }
          field.remove();
        }
        button.textContent = copied ? '已复制' : '请手动复制';
        window.setTimeout(() => {
          button.textContent = original;
        }, 1600);
      });
    });
  }

  // 说明书卡片：复刻日记相纸的手感——悬浮倾角 + 按住边缘翻面。
  // 事件全部委托在 document 上，一次绑定；换页后元素换新，状态每次现查。
  const SPEC_TILT = 2.4; // 正文卡片的倾角上限（度）：比相纸收着，字才不晃不虚
  const SPEC_HOLD_MS = 500; // 边缘按住多久翻面
  const SPEC_BAND = 12; // 悬浮迟滞带：卡片自己会位移，边缘一带容易反复进出
  const SPEC_LEAVE_PX = 8; // 按住后挪动超过这个距离即视为拖动，放弃翻面

  let specEngaged: HTMLElement | null = null; // 正在悬浮的卡片
  let specPress: HTMLElement | null = null;
  let specPressOrigin: { x: number; y: number } | null = null;
  let specPressTimer = 0;
  // 长按翻面后紧跟着的那次松手 click 必须吞掉，否则会立刻翻回去。
  // 用布尔而不是时间窗：按得越久，松手越晚，时间窗总会漏
  let specSwallowClick = false;

  const specReduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const specPaper = (card: Element | null) =>
    card?.querySelector<HTMLElement>('.spec-card-paper') ?? null;

  // 把「翻到哪一面」同步到 DOM：可见面才能被 Tab/读屏碰到，按钮文案跟着换
  const specSync = (card: HTMLElement) => {
    const flipped = card.dataset.flipped === '1';
    card.classList.toggle('is-flipped', flipped);
    const front = card.querySelector<HTMLElement>('.spec-card-face.is-front');
    const back = card.querySelector<HTMLElement>('.spec-card-face.is-back');
    if (front) {
      front.toggleAttribute('inert', flipped);
      front.setAttribute('aria-hidden', String(flipped));
    }
    if (back) {
      back.toggleAttribute('inert', !flipped);
      back.setAttribute('aria-hidden', String(!flipped));
    }
    const toggle = card.querySelector<HTMLButtonElement>('[data-spec-toggle]');
    if (toggle) {
      toggle.setAttribute('aria-pressed', String(flipped));
      toggle.textContent = flipped ? '翻回正面' : '翻到背面';
    }
    const hint = card.querySelector<HTMLElement>('[data-spec-hint]');
    if (hint) hint.textContent = flipped ? '背面 · 一封没寄出的信' : '按住卡片边缘约半秒翻面';
    specSyncUnsents(card.closest('.doc-section'), flipped);
  };

  const specFlip = (card: HTMLElement) => {
    card.dataset.flipped = card.dataset.flipped === '1' ? '0' : '1';
    specSync(card);
  };

  // 只收悬浮，不收翻面：翻过去看过的东西，指针离开时不该自己翻回来
  const specDisengage = () => {
    if (!specEngaged) return;
    specEngaged.classList.remove('is-hover');
    specEngaged.style.setProperty('--rx', '0deg');
    specEngaged.style.setProperty('--ry', '0deg');
    specEngaged = null;
  };

  const specCancelPress = () => {
    window.clearTimeout(specPressTimer);
    specPressTimer = 0;
    specPress?.classList.remove('is-pressing');
    specPress = null;
    specPressOrigin = null;
  };

  const specInBand = (el: HTMLElement, x: number, y: number) => {
    const r = el.getBoundingClientRect();
    return (
      x >= r.left - SPEC_BAND && x <= r.right + SPEC_BAND && y >= r.top - SPEC_BAND && y <= r.bottom + SPEC_BAND
    );
  };

  const initSpec = () => {
    document.querySelectorAll<HTMLElement>('[data-spec-flip]').forEach(specSync);
  };

  // 卡片背面那份折叠区：卡片翻到背面时，它才第一次有位置。
  // 正面朝上时它没有位置（display:none、inert、aria-hidden），
  // 所以开读屏、Tab、Pagefind 和 Ctrl+F 都只会撞见其中一份。
  const specSyncUnsents = (section: Element | null, flipped: boolean) => {
    const back = section?.querySelector<HTMLElement>('[data-unsent-back]');
    if (!back) return;
    back.toggleAttribute('inert', !flipped);
    back.setAttribute('aria-hidden', String(!flipped));
  };

  const initUnsents = () => {
    document.querySelectorAll<HTMLElement>('.doc-section').forEach((section) => {
      const card = section.querySelector<HTMLElement>('[data-spec-flip]');
      specSyncUnsents(section, card?.dataset.flipped === '1');
    });
  };

  // 同样的数字看两遍没意思：正反两份折叠区永远只开着其中一份
  const unsentSync = (details: HTMLDetailsElement) => {
    const section = details.closest('.doc-section');
    const isBack = details.hasAttribute('data-unsent-back');
    const siblings = section
      ? Array.from(section.querySelectorAll<HTMLDetailsElement>('.unsent')).filter(
          (d) => d.hasAttribute('data-unsent-back') === isBack,
        )
      : [];
    if (!details.open) return;
    siblings.forEach((other) => {
      if (other !== details) other.open = false;
    });
  };

  document.addEventListener('toggle', (e) => {
    const details = e.target;
    if (details instanceof HTMLDetailsElement && details.classList.contains('unsent')) {
      unsentSync(details);
    }
  });

  // 边缘长按：按住卡片四条边附近约半秒翻面，中间区域按了不翻；触屏同样可用
  document.addEventListener('pointerdown', (e) => {
    // 新的一次按下，说明上一轮长按的松手 click 不会再来了
    specSwallowClick = false;
    if (e.button !== 0) return;
    const target = e.target instanceof Element ? e.target : null;
    const paper = specPaper(target?.closest('[data-spec-flip]'));
    const card = paper?.closest<HTMLElement>('[data-spec-flip]');
    if (!paper || !card || !target || !paper.contains(target)) return;
    const r = paper.getBoundingClientRect();
    const band = Math.min(72, Math.min(r.width, r.height) * 0.3);
    const nearEdge =
      e.clientX < r.left + band ||
      e.clientX > r.right - band ||
      e.clientY < r.top + band ||
      e.clientY > r.bottom - band;
    if (!nearEdge) return;
    specPress = card;
    specPressOrigin = { x: e.clientX, y: e.clientY };
    card.classList.add('is-pressing');
    specPressTimer = window.setTimeout(() => {
      specPressTimer = 0;
      specPress = null;
      card.classList.remove('is-pressing');
      specFlip(card);
      // 长按翻面后紧跟着的那次松手 click 要吞掉，否则会立刻翻回去
      specSwallowClick = true;
    }, SPEC_HOLD_MS);
  });

  document.addEventListener('pointermove', (e) => {
    // 按住期间挪动（拖动 / 滚屏）视为放弃
    if (
      specPress &&
      specPressOrigin &&
      Math.hypot(e.clientX - specPressOrigin.x, e.clientY - specPressOrigin.y) > SPEC_LEAVE_PX
    ) {
      specCancelPress();
    }
    if (e.pointerType !== 'mouse' || specReduced()) return;
    const card = specEngaged;
    if (!card) return;
    const paper = specPaper(card);
    if (!paper) return;
    const target = e.target instanceof Element ? e.target : null;
    if (!target || !paper.contains(target)) {
      // 指针滑出纸面：迟滞带内先不收，出带才落
      if (!specInBand(paper, e.clientX, e.clientY)) specDisengage();
      return;
    }
    const r = paper.getBoundingClientRect();
    if (r.width <= 0 || r.height <= 0) return;
    const px = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
    const py = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
    card.style.setProperty('--ry', `${((px - 0.5) * 2 * SPEC_TILT).toFixed(2)}deg`);
    card.style.setProperty('--rx', `${((py - 0.5) * 2 * SPEC_TILT).toFixed(2)}deg`);
    card.style.setProperty('--mx', `${(px * 100).toFixed(1)}%`);
    card.style.setProperty('--my', `${(py * 100).toFixed(1)}%`);
  });

  document.addEventListener('pointerover', (e) => {
    if (e.pointerType !== 'mouse' || specReduced()) return;
    const target = e.target instanceof Element ? e.target : null;
    const paper = specPaper(target?.closest('[data-spec-flip]'));
    if (paper && target && paper.contains(target)) {
      const card = paper.closest<HTMLElement>('[data-spec-flip]');
      if (!card || card === specEngaged) return;
      specDisengage();
      specEngaged = card;
      card.classList.add('is-hover');
      return;
    }
    // 指针落到别处：多半是 pointerout 被吞掉（滚动 / 弹层截走）后的补救信号
    if (!specEngaged) return;
    const engagedPaper = specPaper(specEngaged);
    if (engagedPaper && !specInBand(engagedPaper, e.clientX, e.clientY)) specDisengage();
  });

  document.addEventListener('pointerout', (e) => {
    if (!specEngaged) return;
    const paper = specPaper(specEngaged);
    if (!paper) return;
    const to = e.relatedTarget instanceof Node ? e.relatedTarget : null;
    if (to && paper.contains(to)) return;
    if (!specInBand(paper, e.clientX, e.clientY)) specDisengage();
  });

  document.addEventListener('pointerup', specCancelPress);
  document.addEventListener('pointercancel', specCancelPress);

  // 触屏长按别弹出系统菜单 / 选区；桌面右键不受影响（只拦主键长按这一轮）
  document.addEventListener('contextmenu', (e) => {
    if (specPress && e.target instanceof Element && specPress.contains(e.target)) e.preventDefault();
  });

  document.addEventListener('dragstart', (e) => {
    if (e.target instanceof Element && e.target.closest('[data-spec-flip]')) e.preventDefault();
  });

  document.addEventListener('click', (e) => {
    const target = e.target instanceof Element ? e.target : null;
    const toggle = target?.closest<HTMLElement>('[data-spec-toggle]');
    if (toggle) {
      const card = toggle.closest<HTMLElement>('[data-spec-flip]');
      if (card) specFlip(card);
      return;
    }
    const card = target?.closest<HTMLElement>('[data-spec-flip]');
    if (!card) return;
    if (specSwallowClick) {
      // 长按的尾声：这一次 click 只属于刚才那次按压
      specSwallowClick = false;
      return;
    }
    if (card.dataset.flipped !== '1') return; // 正面点击不翻，免得误触
    if (target?.closest('a')) return; // 背面的链接照常能点
    specFlip(card);
  });

  document.addEventListener('astro:page-load', () => {
    specCancelPress();
    specDisengage();
  });

  // 左栏吸附视口底部：把「视口高 - 栏高 - 余量」算成 sticky 的 top，
  // 滚动时整栏下沿一直贴着视口底，页面尾部不再留一大块空。
  function initRailAnchor() {
    const rail = document.querySelector<HTMLElement>('.dossier-rail');
    if (!rail) return;
    const place = () => {
      if (window.matchMedia('(max-width: 900px)').matches) {
        rail.style.top = '';
        return;
      }
      const top = Math.max(106, window.innerHeight - rail.offsetHeight - 32);
      rail.style.top = `${Math.round(top)}px`;
    };
    place();
    window.addEventListener('resize', place, { passive: true });
  }

  function initAbout() {
    initClock();
    initIndex();
    initCopy();
    initSpec();
    initUnsents();
    initRailAnchor();
  }

  initAbout();
  document.addEventListener('astro:page-load', initAbout);
</script>

