---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsoulPeek from '../components/AsoulPeek.astro';
import MinecraftMe from '../components/MinecraftMe.astro';
import MobiusMark from '../components/MobiusMark.astro';
import { siteConfig, withBase } from '../config';
import { beijingDateDot, beijingTime, beijingYear } from '../lib/date';
import { getSortedDiaryEntries } from '../lib/diary-list';
import { steamComments, formatSteamTime, steamProfileUrl } from '../lib/steam-comments';
import pushInfo from '../data/push-info.json';
import '../styles/about.css';

const github = siteConfig.social.github.trim();
const steam = siteConfig.social.steam.trim() || steamProfileUrl;

// 「最后推送」优先取 GitHub 这次提交的时间；本地没有 .git 时退化成构建时间。
// 「最后日记」取 Daily You 同步进来的最新一篇，构建期就能算出来，不用请求。
const pushedAt = new Date(pushInfo.commitAt ?? pushInfo.builtAt);
const pushedIsCommit = Boolean(pushInfo.commitAt);
const pushedText = `${beijingDateDot(pushedAt)} ${beijingTime(pushedAt)}`;
const pushedMonth = beijingDateDot(pushedAt).slice(0, 7);

const newestDiary = (await getSortedDiaryEntries())[0];
const lastDiaryAt = newestDiary ? new Date(newestDiary.data.date) : null;
const lastDiaryText = lastDiaryAt ? beijingDateDot(lastDiaryAt) : '还没有日记';

const sections = [
  { id: 'names', no: '01', label: '名字' },
  { id: 'here', no: '02', label: '这里' },
  { id: 'built', no: '03', label: '建造' },
  { id: 'kit', no: '04', label: '了解' },
  { id: 'friends', no: '05', label: '来往' },
  { id: 'contact', no: '06', label: '联络' },
  { id: 'drop', no: '07', label: '投递' },
];

const names = [
  { value: '小航', where: '站点署名 · 日常', note: '现在用的称呼，重名率有点高，想换一个...' },
  { value: '背井离江的汤姆', where: '昵称 · 自我调侃', note: '远离枝江的奶淇淋，暗戳戳的跟Asoul有关。' },
  { value: 'ivxiaohangvi', where: '字母代号 · ID', note: '现在常用的各平台常用的一串ID。' },
  { value: 'Dawn_HG', where: '代号 · 不知所云', note: '试图给名字加点含义的改名尝试，又有点不知所云。' },
  { value: 'mc123', where: '十年以前 · 旧称', note: '早期玩游戏没英文id随手起的，一直没舍得丢。' },
];

const contact = [
  { label: 'Steam', value: '背井离江的汤姆', href: steam, copy: false },
  { label: 'Bilibili', value: '背井离江的汤姆', href: 'https://space.bilibili.com/280151718', copy: false },
  { label: '163 Music', value: 'Dawn_HG', href: 'https://music.163.com/#/user?id=371853844', copy: false },
  { label: 'Email', value: 'ivxiaohangvi@moxo.cc', href: 'mailto:ivxiaohangvi@moxo.cc', copy: true },
  { label: 'KOOK', value: '🏡 小航の窝', href: 'https://kook.vip/kLP6mr', copy: false },
  { label: 'TeamSpeak 3', value: 'ts.moxo.cc:9987', href: 'ts3server://ts.moxo.cc:9987', copy: false },
];

const latest = steamComments.slice(0, 3);
---

<BaseLayout title="关于" description={`关于${siteConfig.author}（${siteConfig.alias}）与 moxo。`}>
  <div class="wrap about-shell">
    <header class="page-head about-head">
      <!-- 小动图：镜像一下，秋千朝页面里荡。宽屏 fixed 挂在右侧留白里；
           窄屏在下面的媒体查询里改成 absolute，挂在页眉的右上角（它放在 header 里
           就是为了有个定位祖先，fixed 时是脱流的，不影响这里的两列布局）。 -->
      <div class="about-swing" aria-hidden="true">
        <img
          src={withBase('/images/about-swing.png')}
          alt=""
          width="296"
          height="431"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="about-head-main">
        <p class="eyebrow">ABOUT / 关于</p>
        <h1 class="about-title">小航</h1>
        <p class="about-tagline">“{siteConfig.tagline}”</p>
        <div class="about-marks">
          {siteConfig.identity.map((item) => <span>{item}</span>)}
        </div>
      </div>

      <dl class="about-meta">
        <div><dt>档案</dt><dd>XH-2026</dd></div>
        <div><dt>编号</dt><dd>NO. 018</dd></div>
        <div><dt>更新</dt><dd>{pushedMonth}</dd></div>
      </dl>
    </header>

    <div class="dossier">
      <aside class="dossier-rail">
        <nav class="dossier-index" aria-label="页内目录">
          <p class="rail-label">INDEX</p>
          <ol>
            {
              sections.map((section) => (
                <li>
                  <a href={`#${section.id}`} data-index-link={section.id}>
                    <span class="idx-no">{section.no}</span>
                    <span class="idx-label">{section.label}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <section class="status-panel" aria-labelledby="status-label" data-steam-panel data-stale="0">
          <MinecraftMe variant="rail" />
          <p class="rail-label" id="status-label">STATUS / 状态</p>
          <ul class="status-list">
            <li class="status-item is-live">
              <span class="status-k"><i class="status-dot" aria-hidden="true"></i>本地时间</span>
              <span class="status-v" data-clock>--:--:--</span>
            </li>
            <li class="status-item">
              <span class="status-k">Steam</span>
              <span class="status-v" data-steam="state" data-tone="muted">读不到</span>
            </li>
            <li class="status-item">
              <span class="status-k">正在玩</span>
              <span class="status-v is-ellipsis" data-steam="game" data-tone="muted">—</span>
            </li>
            <li class="status-item">
              <span class="status-k">最后在线</span>
              <span class="status-v" data-steam="last" data-tone="muted">—</span>
            </li>
            <li class="status-item">
              <span class="status-k">最后推送</span>
              <span
                class="status-v"
                data-push-time
                data-iso={pushedAt.toISOString()}
                data-tone="plain"
                title={pushedIsCommit ? `GitHub 提交 ${pushInfo.commit ?? ''} · ${pushedText}` : `本地构建 · ${pushedText}`}
              >{pushedText}</span>
            </li>
            <li class="status-item">
              <span class="status-k">最后日记</span>
              <span
                class="status-v"
                data-push-time
                data-iso={lastDiaryAt ? lastDiaryAt.toISOString() : ''}
                data-tone="plain"
                title={lastDiaryAt ? `Daily You 同步 · ${lastDiaryText}` : '还没有日记'}
              >{lastDiaryText}</span>
            </li>
          </ul>
        </section>
      </aside>

      <div class="dossier-body">
        <span class="dossier-tab" aria-hidden="true">DOSSIER · XH-2026 · NO. 018</span>
        <section class="doc-section" id="names" data-index-section>
          <p class="section-no">01 / 名字</p>
          <h2>这些都是我</h2>
          <p class="doc-lede">
            我是小航，一个超级淡人。<br>
            记录、创造、维护、只做我想做的事。
          </p>

          <p>
            域名里的 m 是「我」，oxo 融成了莫比乌斯环，组成了 m<span class="inf">∞</span> 字标，
            <span class="inf">∞</span> 又代表着无限可能。<br>
            沿着它走一圈会回到原点，但它只有一个面——绕了一大圈，看似回到起点，其实早已站在了另一面。
          </p>
          <div class="about-mark" aria-hidden="true">
            <MobiusMark strokeWidth={1.2} />
          </div>

          <dl class="name-table">
            {
              names.map((item) => (
