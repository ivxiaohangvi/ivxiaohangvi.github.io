---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MobiusMark from '../components/MobiusMark.astro';
import FilmRoll from '../components/FilmRoll.astro';
import { getPhotoRolls } from '../lib/photo-rolls';
import { withBase } from '../config';
import '../styles/photos.css';
import '../styles/lightbox.css';

const [photos, rolls] = await Promise.all([getCollection('photos'), getPhotoRolls()]);
---
<BaseLayout title="摄影" description="小航的摄影：镜头里的光线与地方。">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">PHOTOGRAPHS / 摄影</p>
      <div class="page-head-line">
        <h1>摄影</h1>
        <span class="page-count">{String(photos.length).padStart(3, '0')} 格 / {String(rolls.length).padStart(2, '0')} 卷</span>
      </div>
      <p class="page-lede">镜头替我记住的光线。一个相册一卷，装进暗盒——拖拽或方向键过片，拉过卷头卷尾有阻尼，松手自己弹回；点过哪一卷，滚轮就归哪一卷，指针离开片基即还给页面；点开在放大机下把底片冲成正片，也欢迎什么都不做，只是看。</p>
      <a class="text-link page-head-link" href={withBase('/photos/archive/')}>按卷收进胶卷柜 <span aria-hidden="true">→</span></a>
    </header>
  </div>

  {
    rolls.length > 0 ? (
      rolls.map((roll) => <FilmRoll roll={roll} />)
    ) : (
      <div class="wrap">
        <div class="contact-sheet empty-state">
          <div class="contact-frame" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>
          <div class="contact-copy">
            <MobiusMark class="empty-mark" />
            <p class="empty-kicker">ROLL NOT DEVELOPED</p>
            <h2>胶片还没冲洗</h2>
            <p>等我带着照片回来。这里会是一面不着急的墙。</p>
            <a class="text-link" href={withBase('/diary/')}>去日记里找点光 <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    )
  }

  <dialog id="lightbox" class="photo-lightbox" aria-label="冲印并查看大图" tabindex="-1">
    <button class="lightbox-close" type="button" aria-label="关闭灯箱">
      <span class="lightbox-close-label">关灯</span>
      <span class="lightbox-close-x" aria-hidden="true">×</span>
    </button>
    <div class="lightbox-plate">
      <div class="lightbox-stage">
        <img id="lightbox-img" alt="" draggable="false" decoding="async" />
        <span class="lightbox-veil" aria-hidden="true"></span>
        <span class="lightbox-sweep" aria-hidden="true"></span>
      </div>
      <div class="lightbox-rail" role="group" aria-label="本卷片格" hidden>
        <div class="lightbox-rail-track"></div>
      </div>
    </div>
    <p class="lightbox-caption">
      <span class="lightbox-copy"><strong id="lightbox-title"></strong><span id="lightbox-meta"></span></span>
      <span class="lightbox-count" id="lightbox-count" aria-hidden="true"></span>
    </p>
  </dialog>

  <script>
    import { gsap } from 'gsap';
    /* 走带控制器随模块自初始化；这里只借它把滚轮在开灯时收回 */
    import { disarmFilmRolls } from '../scripts/film-rolls';

    /* ClientRouter 只换 body，<html> 会留下；换页时务必摘掉滚动锁 */
    document.addEventListener('astro:before-swap', () => {
      document.documentElement.classList.remove('is-lightbox-open');
    });

    document.addEventListener('astro:page-load', () => {
      const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
      if (!dialog || dialog.dataset.ready === 'true') return;
      dialog.dataset.ready = 'true';

      const img = dialog.querySelector('#lightbox-img') as HTMLImageElement;
      const veil = dialog.querySelector('.lightbox-veil') as HTMLElement;
      const sweep = dialog.querySelector('.lightbox-sweep') as HTMLElement;
      const title = dialog.querySelector('#lightbox-title') as HTMLElement;
      const meta = dialog.querySelector('#lightbox-meta') as HTMLElement;
      const count = dialog.querySelector('#lightbox-count') as HTMLElement;
      const rail = dialog.querySelector('.lightbox-rail') as HTMLElement;
      const railTrack = dialog.querySelector('.lightbox-rail-track') as HTMLElement;
      const plate = dialog.querySelector('.lightbox-plate') as HTMLElement;
      const stage = dialog.querySelector('.lightbox-stage') as HTMLElement;

      /* 空闲时把走带上的中图全部解码好：首次下滑时解码开销不再落在滚动窗口里
         （decode() 会顺带触发 lazy 图提前取回，中图都很小，整卷也就几百 KB） */
      const predecode = () => {
        document.querySelectorAll<HTMLImageElement>('.film-viewport img.pimg').forEach((picture) => {
          picture.decode().catch(() => {});
        });
      };
      if ('requestIdleCallback' in window) requestIdleCallback(predecode, { timeout: 3000 });
      else setTimeout(predecode, 300);

      /* 冲印流程：负片上墙 → 曝光扫光 → 显影出正片，一条 GSAP timeline 走完。
         换片/关闭随时 kill；openToken 让迟到的 decode 碰不到当前这一格 */
      const NEG_FILTER = 'invert(1) hue-rotate(180deg) contrast(0.92) brightness(0.97) saturate(0.9)';
      const POS_FILTER = 'invert(0) hue-rotate(0deg) contrast(1) brightness(1) saturate(1)';
      const pad2 = (value: number) => String(value).padStart(2, '0');
      const lockScroll = (locked: boolean) =>
        document.documentElement.classList.toggle('is-lightbox-open', locked);

      let gallery: HTMLButtonElement[] = [];
      let cursor = 0;
      let openToken = 0;
      let railFitRaf = 0;
      let printTl: gsap.core.Timeline | null = null;

      /* 本卷片格：一条真片基上的齿孔索引。孔位就是画幅，点孔换片；
         一次只留一枚在 Tab 序列里，方向键沿片边移焦点 */
      const buildRail = () => {
        railTrack.replaceChildren(
          ...gallery.map((pic, index) => {
            const hole = document.createElement('button');
            hole.type = 'button';
            hole.className = 'lightbox-hole';
            hole.dataset.i = String(index);
            hole.setAttribute('aria-label', `第 ${index + 1} 格 · ${pic.dataset.title ?? '照片'}`);
            const code = document.createElement('span');
            code.className = 'lightbox-hole-code';
            code.textContent = `${pad2(index + 1)}A`;
            hole.append(code);
            return hole;
          }),
        );
        rail.hidden = gallery.length <= 1;
        plate.style.removeProperty('width');
        railTrack.scrollLeft = 0;
      };

      const paintChrome = () => {
        count.textContent = `${pad2(cursor + 1)} / ${pad2(gallery.length)}`;
        const holes = [...railTrack.querySelectorAll<HTMLButtonElement>('.lightbox-hole')];
        holes.forEach((hole, index) => {
          const on = index === cursor;
          hole.classList.toggle('is-on', on);
          hole.tabIndex = on ? 0 : -1;
          if (on) hole.setAttribute('aria-current', 'true');
          else hole.removeAttribute('aria-current');
        });
        const active = holes[cursor];
        if (active) {
          const left = active.offsetLeft - (railTrack.clientWidth - active.offsetWidth) / 2;
          railTrack.scrollLeft = Math.max(0, left);
        }
      };

      /* 相纸与片基共用同一套尺寸上限：CSS 的 max-width / max-height 解成像素 */
      const plateLimits = () => ({
        maxW: parseFloat(getComputedStyle(dialog).maxWidth) || window.innerWidth,
        maxH: parseFloat(getComputedStyle(img).maxHeight) || window.innerHeight,
      });

      /* 相纸按当前格宽高先占好位：img 双轴 auto，decode 之前没有内在尺寸，
         不占位时灯箱会先按片基+字幕的高度居中，图一解码完再整体跳一次 */
      const reserveStage = (pic: HTMLButtonElement | undefined) => {
        if (!pic) return;
        const thumb = pic.querySelector('img');
        const w = Number(thumb?.getAttribute('width')) || thumb?.naturalWidth || 0;
        const h = Number(thumb?.getAttribute('height')) || thumb?.naturalHeight || 0;
        if (!w || !h) {
          stage.style.removeProperty('width');
          stage.style.removeProperty('height');
          return;
        }
        const { maxW, maxH } = plateLimits();
        const scale = Math.min(maxW / w, maxH / h);
        stage.style.width = `${Math.round(w * scale)}px`;
        stage.style.height = `${Math.round(h * scale)}px`;
      };

      /* 片基按整卷最宽的一格定长：竖幅切横幅时片基不再被拉长/压短。
         宽度写在 plate 上，灯箱首帧就是最终长度；rail 交给 min-width:100% 铺满，
         不再等 rail 的宽度过渡解析完才撑开灯箱 */
      const fitRail = () => {
        if (gallery.length <= 1) {
          plate.style.removeProperty('width');
          return;
        }
        const { maxW, maxH } = plateLimits();
        let widest = 0;
        for (const pic of gallery) {
          const thumb = pic.querySelector('img');
          const w = Number(thumb?.getAttribute('width')) || thumb?.naturalWidth || 0;
          const h = Number(thumb?.getAttribute('height')) || thumb?.naturalHeight || 0;
          if (!w || !h) continue;
          widest = Math.max(widest, Math.min(maxW, maxH * (w / h)));
        }
        if (widest > 0) plate.style.width = `${Math.round(widest)}px`;
      };

      const resetDarkroom = () => {
        printTl?.kill();
        printTl = null;
        dialog.classList.remove('is-developing');
        gsap.set(img, { clearProps: 'filter' });
        gsap.set(veil, { clearProps: 'opacity' });
        gsap.set(sweep, { clearProps: 'opacity,transform' });
      };

      const develop = (quick: boolean) => {
        gsap.set(img, { filter: NEG_FILTER });
        gsap.set(veil, { opacity: 1 });
        gsap.set(sweep, { opacity: 0, xPercent: -130, skewX: -8 });
        dialog.classList.add('is-developing');

        const scale = quick ? 0.62 : 1;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const tl = (printTl = gsap.timeline({
          onComplete: () => {
            if (printTl !== tl) return;
            printTl = null;
            dialog.classList.remove('is-developing');
          },
        }));

        if (reduced) {
          /* 减少动态：不扫光，负片短暂停留后快速显影 */
          tl.to(img, { filter: POS_FILTER, duration: 0.28, ease: 'power1.inOut' }, 0.08).to(
            veil,
            { opacity: 0, duration: 0.28, ease: 'power1.inOut' },
            0.08,
          );
          return;
        }

        tl
          /* 曝光扫光：淡入 → 推过相纸 → 收掉 */
          .to(sweep, { opacity: 1, duration: 0.12 * scale, ease: 'power1.out' })
          .to(sweep, { xPercent: 320, duration: 0.62 * scale, ease: 'power1.inOut' }, '<')
          .to(sweep, { opacity: 0, duration: 0.12 * scale, ease: 'power1.in' }, '-=0.12')
          /* 显影：滤镜逐帧退回正片，橙罩随退，出片后红灯熄灭 */
          .to(img, { filter: POS_FILTER, duration: 1.35 * scale, ease: 'power1.inOut' }, '-=0.05')
          .to(veil, { opacity: 0, duration: 1.35 * scale, ease: 'power1.inOut' }, '<');
      };

      /* 原图只在开灯时才取：中图先撑住相纸，原图解码完再悄悄换像素。
         同一构图同尺寸，换源不会跳版，也不会把人拉回负片态 */
      const upgrade = (pic: HTMLButtonElement, token: number) => {
        const full = pic.dataset.full;
        if (!full || img.getAttribute('src') === full) return;
        const loader = new Image();
        loader.decoding = 'async';
        loader.src = full;
        loader.decode().then(
          () => {
            if (token !== openToken || !dialog.open || !loader.naturalWidth) return;
            if (img.getAttribute('src') !== full) img.src = full;
          },
          () => {
            /* 原图取不到就继续用中图，不把相纸换空 */
          },
        );
      };

      /* 当前这张亮起来之后，趁空闲把相邻格的中图与原图悄悄收进缓存，
         换片时不需要再等网络与解码 */
      const prefetched = new Set<string>();
      const idlePrefetch = (task: () => void) => {
        if ('requestIdleCallback' in window) requestIdleCallback(() => task(), { timeout: 1600 });
        else window.setTimeout(task, 500);
      };
      const prefetchOne = (url: string | undefined) => {
        if (!url || prefetched.has(url)) return;
        prefetched.add(url);
        const loader = new Image();
        loader.decoding = 'async';
        loader.src = url;
        loader.decode().catch(() => {
          prefetched.delete(url);
        });
      };
      const prefetchNeighbors = (index: number) => {
        if (!dialog.open) return;
        for (const pic of [gallery[index - 1], gallery[index + 1]]) {
          if (!pic) continue;
          const thumb = pic.querySelector('img');
          prefetchOne(thumb?.src);
          prefetchOne(pic.dataset.full);
        }
      };

      const showAt = (index: number, quick: boolean, focusRail = false) => {
        if (!gallery.length) return;
        cursor = Math.max(0, Math.min(gallery.length - 1, index));
        const at = cursor;
        const pic = gallery[at];
        const thumb = pic.querySelector('img');
        const token = ++openToken;

        resetDarkroom();
        /* 先撤旧像素再换源：否则新原图未解码时，<img> 会把上一张继续挂在墙上 */
        dialog.classList.add('is-loading');
        img.removeAttribute('src');

        img.alt = pic.dataset.title ?? '';
        const width = thumb?.getAttribute('width');
        const height = thumb?.getAttribute('height');
        if (width && height) {
          img.setAttribute('width', width);
          img.setAttribute('height', height);
        } else {
          img.removeAttribute('width');
          img.removeAttribute('height');
        }

        title.textContent = pic.dataset.title ?? '';
        meta.textContent = pic.dataset.meta ?? '';
        dialog.setAttribute('aria-label', `${pic.dataset.title ?? '照片'}，第 ${at + 1} 张，共 ${gallery.length} 张`);

        gsap.set(img, { filter: NEG_FILTER });
        gsap.set(veil, { opacity: 1 });
        gsap.set(sweep, { opacity: 0, xPercent: -130, skewX: -8 });
        dialog.classList.add('is-developing');

        img.src = thumb?.currentSrc || thumb?.src || pic.dataset.full || '';
        if (!dialog.open) {
          dialog.showModal();
          lockScroll(true);
          /* 必须先上墙再量：fitRail 读的是相纸在当前视口里的最大尺寸 */
          fitRail();
          /* 焦点落在灯箱本身而不是关灯签：避免一开灯就亮出一圈
             只有键盘才需要的焦点框，Tab 时再交给关闭键与齿孔 */
          if (!focusRail) dialog.focus({ preventScroll: true });
        }
        reserveStage(pic);
        paintChrome();
        if (focusRail) {
          railTrack.querySelector<HTMLButtonElement>('.lightbox-hole.is-on')?.focus({ preventScroll: true });
        }

        const start = () => {
          if (token !== openToken) return;
          dialog.classList.remove('is-loading');
          develop(quick);
          upgrade(pic, token);
          idlePrefetch(() => prefetchNeighbors(at));
        };
        /* 中图解码后再亮负片，显影的扫光不会扫在空相纸上 */
        if (typeof img.decode === 'function') img.decode().then(start, start);
        else start();
      };

      const step = (direction: -1 | 1) => {
        const next = cursor + direction;
        if (next < 0 || next >= gallery.length) return;
        showAt(next, true, true);
      };

      railTrack.addEventListener('click', (event) => {
        const hole = (event.target as Element).closest<HTMLButtonElement>('.lightbox-hole');
        if (!hole) return;
        const index = Number(hole.dataset.i);
        if (!Number.isInteger(index) || index === cursor) return;
        showAt(index, true, true);
      });

      document.querySelectorAll<HTMLButtonElement>('.fs-pic[data-full]').forEach((pic) => {
        pic.addEventListener('click', () => {
          /* 拖完胶片紧跟的 click 已在控制器里截掉，这里只处理真正的点开 */
          disarmFilmRolls();
          const strip = pic.closest('.filmstrip');
          const pics = [...(strip?.querySelectorAll<HTMLButtonElement>('.fs-pic[data-full]') ?? [])].filter(
            (item) => item.dataset.full,
          );
          /* 右侧卷的 DOM 顺序与视觉顺序相反：反向后再按"左=上一张"排 */
          if (strip?.classList.contains('side-right')) pics.reverse();
          gallery = pics;
          buildRail();
          const index = pics.indexOf(pic);
          if (index >= 0) showAt(index, false);
        });
      });

      document.addEventListener('keydown', (event) => {
        if (!dialog.open || event.metaKey || event.ctrlKey || event.altKey) return;
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          step(-1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          step(1);
        } else if (event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          if (gallery.length) showAt(event.key === 'Home' ? 0 : gallery.length - 1, true, true);
        }
      });

      /* <dialog> 在 top layer 但不会自己锁滚轮；兜底挡掉原生滚动，
         站内滚轮缓动看到 dialog[open] 也会让路 */
      dialog.addEventListener('wheel', (event) => event.preventDefault(), { passive: false });

      dialog.addEventListener('click', (event) => {
        const target = event.target as Element;
        if (event.target === dialog || target.closest('.lightbox-close')) dialog.close();
      });

      dialog.addEventListener('close', () => {
        openToken += 1;
        resetDarkroom();
        dialog.classList.remove('is-loading');
        img.removeAttribute('src');
        img.removeAttribute('width');
        img.removeAttribute('height');
        plate.style.removeProperty('width');
        stage.style.removeProperty('width');
        stage.style.removeProperty('height');
        lockScroll(false);
      });

      window.addEventListener('resize', () => {
        if (!dialog.open) return;
        cancelAnimationFrame(railFitRaf);
        railFitRaf = requestAnimationFrame(() => {
          reserveStage(gallery[cursor]);
          fitRail();
          paintChrome();
        });
      });
    });
  </script>
</BaseLayout>
