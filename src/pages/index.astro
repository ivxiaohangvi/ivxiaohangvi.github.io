---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MoodBadge from '../components/MoodBadge.astro';
import MoodSpectrum from '../components/MoodSpectrum.astro';
import LiveInfinity from '../components/LiveInfinity.astro';
import { moodInfo } from '../lib/mood';
import { siteConfig, withBase } from '../config';
import { beijingDateDot, beijingIso, beijingMonthDay, beijingTime } from '../lib/date';

const [diary, moments, photos, tools, posts] = await Promise.all([
  getCollection('diary'),
  getCollection('moments'),
  getCollection('photos'),
  getCollection('tools'),
  getCollection('blog', ({ data }) => !data.draft),
]);

const byDate = <T extends { data: { date: Date } }>(a: T, b: T) => b.data.date.valueOf() - a.data.date.valueOf();
const byPubDate = <T extends { data: { pubDate: Date } }>(a: T, b: T) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

diary.sort(byDate);
moments.sort(byDate);
photos.sort(byDate);
posts.sort(byPubDate);

const latestDiary = diary[0];
const latestMoment = moments[0];
const latestPhoto = photos[0];
const latestPost = posts[0];
const latestTool = tools.sort((a, b) => a.data.order - b.data.order)[0];

const plain = (markdown = '') =>
  markdown
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[#>*_`~]/g, '')
    .replace(/\s+/g, ' ')
    .trim();

const shortDate = (date: Date) => beijingMonthDay(date);
const longDate = (date: Date) => beijingDateDot(date);
const stamped = (date: Date, withTime = false) =>
  `${longDate(date)}${withTime ? ` ${beijingTime(date)}` : ''}`;

const rows = [
  {
    no: '01',
    href: '/diary/',
    name: '迹忆',
    en: 'FIELD NOTES',
    desc: '每天的心情与记录，从 Daily You 同步而来。',
    count: diary.length,
    unit: '篇',
    latest: latestDiary
      ? `${stamped(latestDiary.data.date, latestDiary.data.timeKnown)}${latestDiary.data.sample ? ' · 示例' : ''}`
      : '等待第一篇',
  },
  {
    no: '02',
    href: '/moments/',
    name: '动态',
    en: 'MOMENTS',
    desc: '来不及写成日记的碎碎念。',
    count: moments.length,
    unit: '则',
    latest: latestMoment ? shortDate(latestMoment.data.date) : '留白中',
  },
  {
    no: '03',
    href: '/photos/',
    name: '摄影',
    en: 'PHOTOGRAPHS',
    desc: '镜头替我记住的光线。',
    count: photos.length,
    unit: '张',
    latest: latestPhoto ? latestPhoto.data.title : '胶片未冲洗',
  },
  {
    no: '04',
    href: '/tools/',
    name: '工具',
    en: 'SMALL TOOLS',
    desc: '自己搓的小东西，解决自己的小麻烦。',
    count: tools.length,
    unit: '件',
    latest: latestTool ? latestTool.data.name : '工作台上还没东西',
  },
  {
    no: '05',
    href: '/blog/',
    name: '文章',
    en: 'LONG NOTES',
    desc: '稍微认真一点写下的长文。',
    count: posts.length,
    unit: '篇',
    latest: latestPost ? latestPost.data.title : '还没落笔',
  },
];

const moodDiary = diary.filter((entry) => Boolean(moodInfo(entry.data.mood, entry.data.moodKey)));
const allSample = diary.length > 0 && diary.every((entry) => entry.data.sample);
const nowMood = latestDiary ? moodInfo(latestDiary.data.mood, latestDiary.data.moodKey) : null;
const nightFlight = diary.find((entry) => entry.id === '2026-10-25-night-flight');
const nightExcerpt = nightFlight ? plain(nightFlight.body).slice(0, 104) : '';
const nightMore = nightFlight ? plain(nightFlight.body).length > 104 : false;
---
<BaseLayout>
  <div class="home wrap">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-rail" aria-hidden="true">
        <span>FIELD NOTES</span>
        <span class="rail-line"></span>
        <span>MOXO.CC / 2026</span>
      </div>

      <div class="hero-main" data-animate="hero-title">
        <p class="eyebrow"><span class="eyebrow-inf">∞</span> 小航的无限空间</p>
        <h1 class="hero-title" id="hero-title">
          <span class="hero-line">背井离江</span>
          <span class="hero-line hero-line-2">的汤姆<LiveInfinity class="hero-inf" arc={26} /></span>
        </h1>
        <p class="hero-lede">
          我是小航。INFP。迹忆、观察、创造，做自己想做的事。<br />
          把日子绕成一个莫比乌斯环——没有背面，所以哪一面都算正面。
        </p>
        <div class="hero-meta">
          <span>{siteConfig.alias.toUpperCase()}</span>
          <span>SINCE {siteConfig.startYear}</span>
          <span>∞ POSSIBILITIES</span>
        </div>
      </div>

      <aside class="now-card" aria-label="最近的迹忆" data-reveal>
        <div class="now-head">
          <span>此刻 / NOW</span>
          {latestDiary && (
            <time datetime={beijingIso(latestDiary.data.date)}>
              {longDate(latestDiary.data.date)}
              {latestDiary.data.timeKnown && <span class="now-time"> · {beijingTime(latestDiary.data.date)}</span>}
            </time>
          )}
        </div>
        {
          latestDiary ? (
            <>
              {(nowMood || latestDiary.data.sample) && (
                <div class="now-mood">
                  {nowMood && <MoodBadge mood={latestDiary.data.mood} moodKey={latestDiary.data.moodKey} size="lg" />}
                  {latestDiary.data.sample && <span class="sample-stamp">示例</span>}
                </div>
              )}
              <p class="now-text">{plain(latestDiary.body).slice(0, 120)}{plain(latestDiary.body).length > 120 ? '…' : ''}</p>
              <div class="now-foot">
                <span class="now-caption">{nowMood ? `这一天的心情：${nowMood.label}` : '心情未知'}</span>
                <a class="text-link" href={withBase(`/diary/${latestDiary.id}/`)}>读这一页 <span aria-hidden="true">→</span></a>
              </div>
            </>
          ) : (
            <>
              <p class="now-text">还没有留下第一篇。空白也是生活的一部分。</p>
              <div class="now-foot">
                <span class="now-caption">等待第一条记录</span>
                <a class="text-link" href={withBase('/diary/')}>去迹忆 <span aria-hidden="true">→</span></a>
              </div>
            </>
          )
        }
      </aside>
    </section>

    <section class="index-section" aria-labelledby="index-title">
      <header class="section-head">
        <span class="section-no">01</span>
        <h2 id="index-title">空间索引</h2>
        <p>五个抽屉，装着不同的我。</p>
      </header>
      <div class="index-grid">
        {
          rows.map((row, index) => (
            <a class:list={['index-card', { 'is-lead': index === 0 }]} href={withBase(row.href)} data-reveal>
              <span class="index-top">
                <span class="index-num">{row.no}</span>
                <span class="index-arrow" aria-hidden="true">↗</span>
              </span>
              <span class="index-name">{row.name}</span>
              <span class="index-en">{row.en}</span>
              <span class="index-desc">{row.desc}</span>
              <span class="index-foot">
                <span class="index-latest">{row.latest}</span>
                <span class="index-count">{row.count > 0 ? `${row.count} ${row.unit}` : '—'}</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    {
      moodDiary.length > 0 && (
        <section class="mood-section" aria-labelledby="mood-title">
          <header class="section-head">
            <span class="section-no">02</span>
            <h2 id="mood-title">心情光谱</h2>
            <p>心情不是标签，只是那一天留下的光。</p>
          </header>
          <MoodSpectrum
            entries={moodDiary}
            note={allSample ? '这些是导入测试留下的示例，等真实日记来了就替换掉。' : undefined}
          />
        </section>
      )
    }

    {
      nightFlight && (
        <section class="night-section" aria-labelledby="night-title">
          <div class="night-scene" aria-hidden="true">
            <svg class="night-route" viewBox="0 0 560 380" fill="none">
              <path
                class="night-route-line"
                d="M32 330C118 330 152 270 210 244C278 214 292 138 370 126C426 117 470 78 522 48"
                stroke="currentColor"
                stroke-width="1.1"
                stroke-dasharray="2 8"
                stroke-linecap="round"
              />
              <circle cx="32" cy="330" r="3" fill="currentColor" />
              <circle cx="522" cy="48" r="2.2" fill="currentColor" />
              <g class="night-plane" opacity="0" aria-hidden="true">
                <circle r="6.5" fill="#e8b96a" opacity="0.18" />
                <circle r="2.4" fill="#e8b96a" />
              </g>
            </svg>
            <span class="night-moon"></span>
            <span class="night-star star-1"></span>
            <span class="night-star star-2"></span>
            <span class="night-star star-3"></span>
            <span class="night-star star-4"></span>
            <span class="night-star star-5"></span>
            <span class="night-scene-label">NIGHT FLIGHT / BJT</span>
            <svg class="night-sea" viewBox="0 0 600 120" preserveAspectRatio="none" fill="none">
              <path
                d="M0 66C68 48 124 48 192 66S316 84 384 66 508 48 600 66"
                stroke="currentColor"
                stroke-width="1"
              />
              <path
                d="M0 84C68 66 124 66 192 84S316 102 384 84 508 66 600 84"
                stroke="currentColor"
                stroke-width="1"
                opacity=".45"
              />
            </svg>
          </div>
          <div class="night-copy" data-reveal>
            <p class="section-no">03 / NIGHT FLIGHT</p>
            <h2 id="night-title">夜航</h2>
            <p class="night-excerpt">“{nightExcerpt}{nightMore ? '…' : ''}”</p>
            <p class="night-meta">
              <time datetime={beijingIso(nightFlight.data.date)}>{stamped(nightFlight.data.date, nightFlight.data.timeKnown)}</time>
              <span>深夜的这一页 · BJT</span>
            </p>
            <a class="text-link night-link" href={withBase(`/diary/${nightFlight.id}/`)}>
              读这一页 <span aria-hidden="true">→</span>
            </a>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
