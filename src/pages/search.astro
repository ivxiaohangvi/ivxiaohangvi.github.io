---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WordDriftCloud from '../components/WordDriftCloud.astro';
import { layoutWordCloud } from '../lib/word-cloud-layout';
import { buildWordField } from '../lib/word-field';
import { pinyin } from 'pinyin-pro';
import '../styles/word-field.css';

const [diary, moments, blog] = await Promise.all([
  getCollection('diary'),
  getCollection('moments'),
  getCollection('blog', ({ data }) => !data.draft),
]);
const wordField = buildWordField([...diary, ...moments, ...blog]);
const wordNote = `${wordField.sourceCount} 篇公开记录 · ${wordField.words.length} 个词`;

const driftDesktop = layoutWordCloud(wordField.words, {
  width: 720,
  height: 400,
  sizes: { 1: 60, 2: 44, 3: 33, 4: 24 },
  padding: 8,
  gap: 9,
  seed: 23757,
  shape: 3.2,
  bands: { 1: [0.02, 0.28], 2: [0.26, 0.56], 3: [0.5, 0.8], 4: [0.7, 0.97] },
});

const driftMobile = layoutWordCloud(wordField.words, {
  width: 360,
  height: 520,
  sizes: { 1: 44, 2: 33, 3: 26, 4: 20 },
  padding: 5,
  gap: 8,
  seed: 2718,
  shape: 3.2,
  bands: { 1: [0.02, 0.38], 2: [0.24, 0.62], 3: [0.44, 0.82], 4: [0.62, 1.0] },
  ampScale: 0.8,
});

// 词场里每个词的逐字拼音、以及每个音的候选字（都取自词场自身），构建期算好交给浏览器。
const PINYIN_OPTIONS = { toneType: 'none', type: 'array' } as const;
const wordSyllables: Record<string, string[]> = {};
const syllableCandidates: Record<string, string[]> = {};
for (const item of wordField.words) {
  const chars = [...item.word];
  const syllables = pinyin(item.word, PINYIN_OPTIONS) as string[];
  if (syllables.length === chars.length) wordSyllables[item.word] = syllables;
  for (let index = 0; index < chars.length; index += 1) {
    const syllable = syllables[index];
    if (!syllable || !/^[a-z]+$/.test(syllable) || !/\p{Script=Han}/u.test(chars[index])) continue;
    const pool = (syllableCandidates[syllable] ??= []);
    if (!pool.includes(chars[index]) && pool.length < 6) pool.push(chars[index]);
  }
}
const typingData = JSON.stringify({ syllables: wordSyllables, candidates: syllableCandidates }).replace(/</g, '\\u003c');
---
<BaseLayout title="搜索" description="搜索 moxo 里的迹忆、动态与文章。">
  <div class="wrap-narrow">
    <header class="page-head">
      <p class="eyebrow">SEARCH / 搜索</p>
      <div class="page-head-line">
        <h1>搜索</h1>
      </div>
      <p class="page-lede">在迹忆、动态和文章里找一句话。按 <kbd>/</kbd> 直接开始，或从词场点一个词。</p>
    </header>

    <div class="search-box">
      <label class="search-label" for="search-input">关键词</label>
      <input id="search-input" type="search" placeholder="比如：莫比乌斯、摄影、深夜…" autocomplete="off" spellcheck="false" />
      <p id="search-hint" class="search-hint">
        搜索索引在构建时由 Pagefind 生成；本地开发模式下不可用，执行
        <code>npm run build &amp;&amp; npm run preview</code> 可以体验完整效果。
      </p>
      <div class="search-ime" id="search-ime" hidden aria-hidden="true">
        <div class="search-ime-head">
          <span class="search-ime-compose" data-search-ime-compose></span>
          <span class="search-ime-mode">全拼</span>
        </div>
        <div class="search-ime-list" data-search-ime-list></div>
      </div>
    </div>

    {
      wordField.words.length > 0 && (
        <section class="word-field" data-word-field data-pagefind-ignore aria-labelledby="word-field-title">
          <div class="word-field-head">
            <h2 id="word-field-title">词场 / WORD FIELD</h2>
            <span class="word-field-note" data-word-note>{wordNote}</span>
          </div>
          <div class="word-field-stage">
            <WordDriftCloud layout={driftDesktop} variant="desktop" />
            <WordDriftCloud layout={driftMobile} variant="mobile" />
          </div>
        </section>
      )
    }

    <div id="search-loading" class="search-loading" role="status" hidden>
      <svg viewBox="0 0 80 48" fill="none" aria-hidden="true">
        <path class="sl-track" pathLength="1" d="M8 24C8 10 28 8 40 24C52 40 72 38 72 24C72 10 52 8 40 24C28 40 8 38 8 24Z"></path>
        <path class="sl-trail sl-trail--long" pathLength="1" d="M8 24C8 10 28 8 40 24C52 40 72 38 72 24C72 10 52 8 40 24C28 40 8 38 8 24Z"></path>
        <path class="sl-trail sl-trail--mid" pathLength="1" d="M8 24C8 10 28 8 40 24C52 40 72 38 72 24C72 10 52 8 40 24C28 40 8 38 8 24Z"></path>
        <path class="sl-trail sl-trail--head" pathLength="1" d="M8 24C8 10 28 8 40 24C52 40 72 38 72 24C72 10 52 8 40 24C28 40 8 38 8 24Z"></path>
      </svg>
      <span class="search-loading-text">搜索中…</span>
    </div>

    <script type="application/json" data-search-typing set:html={typingData}></script>

    <div id="search-results" class="search-results" aria-live="polite"></div>
  </div>

  <style>
    .word-field-stage {
      margin-top: 1.35rem;
    }

    @media (max-width: 560px) {
      .word-field-stage {
        margin-top: 1.1rem;
      }
    }
  </style>

  <script>
    import { gsap } from 'gsap';

    import { installSearchQuerySegmenter } from '../lib/search-query-segmenter';
    import { typeWordIntoSearch } from '../lib/search-typing';

    type PagefindResultData = {
      url: string;
      excerpt: string;
      meta: { title?: string };
    };

    type Pagefind = {
      search(query: string): Promise<{
        results: { data(): Promise<PagefindResultData> }[];
      }>;
    };

    let pagefind: Pagefind | null = null;

    async function ensurePagefind(): Promise<Pagefind | null> {
      if (!import.meta.env.PROD) return null;
      if (pagefind) return pagefind;
      try {
        // 让查询切词与索引切词同口径（中文词表最长匹配），必须在 import pagefind.js 之前安装。
        await installSearchQuerySegmenter();
        const path = `${import.meta.env.BASE_URL}pagefind/pagefind.js`;
        pagefind = (await import(/* @vite-ignore */ path)) as unknown as Pagefind;
      } catch {
        pagefind = null;
      }
      return pagefind;
    }

    function escapeHtml(text: string): string {
      return text
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }

    function safeExcerpt(html: string): string {
      return escapeHtml(html).replaceAll('&lt;mark&gt;', '<mark>').replaceAll('&lt;/mark&gt;', '</mark>');
    }

    /** 连续输入会高频重渲染：用 context 收口，上一轮 tween（元素已被替换）一并杀掉 */
    let resultsAnim: gsap.Context | null = null;

    function renderResults(items: PagefindResultData[], query: string): void {
      const box = document.getElementById('search-results');
      if (!box) return;
      if (!query) {
        resultsAnim?.revert();
        resultsAnim = null;
        box.innerHTML = '';
        return;
      }
      box.innerHTML =
        items.length === 0
          ? `<p class="search-empty">没有找到「${escapeHtml(query)}」。换个词试试。</p>`
          : items
              .map(
                (item) => `
                  <a class="search-result" href="${item.url}">
                    <span class="search-result-kind">${
                      item.url.includes('/diary/')
                        ? '迹忆'
                        : item.url.includes('/moments/')
                          ? '动态'
                          : item.url.includes('/blog/')
                            ? '文章'
                            : '页面'
                    }</span>
                    <strong>${escapeHtml(item.meta.title ?? item.url)}</strong>
                    <span class="search-result-excerpt">${safeExcerpt(item.excerpt)}</span>
                  </a>`,
              )
              .join('');

      const cards = box.querySelectorAll('.search-result');
      if (cards.length === 0 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        resultsAnim?.revert();
        resultsAnim = null;
        return;
      }
      resultsAnim?.revert();
      resultsAnim = gsap.context(() => {
        gsap.from(cards, {
          y: 14,
          autoAlpha: 0,
          duration: 0.4,
          ease: 'power2.out',
          stagger: 0.045,
          clearProps: 'all',
        });
      });
    }

    async function initSearch(): Promise<void> {
      const input = document.getElementById('search-input') as HTMLInputElement | null;
      const hint = document.getElementById('search-hint');
      if (!input) return;

      const field = document.querySelector<HTMLElement>('[data-word-field]');
      const note = field?.querySelector<HTMLElement>('[data-word-note]') ?? null;
      const defaultNote = note?.textContent ?? '';

      const syncQuery = (query: string): void => {
        const url = new URL(window.location.href);
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        window.history.replaceState(null, '', url);
      };

      const describe = (target: EventTarget | null): void => {
        const link = target instanceof Element ? target.closest<HTMLAnchorElement>('a[data-word]') : null;
        if (!note || !link) return;
        note.textContent = `「${link.dataset.word}」${link.dataset.count} 篇 · 最近 ${link.dataset.last}`;
      };
      const restoreNote = (): void => {
        if (note) note.textContent = defaultNote;
      };

      const pf = await ensurePagefind();
      if (pf) hint?.remove();

      const typingScript = document.querySelector<HTMLScriptElement>('script[data-search-typing]');
      let typingData: { syllables: Record<string, string[]>; candidates: Record<string, string[]> } = {
        syllables: {},
        candidates: {},
      };
      try {
        const parsed = typingScript?.textContent ? JSON.parse(typingScript.textContent) : null;
        if (parsed && typeof parsed === 'object') typingData = parsed;
      } catch {
        /* 数据坏了就退回“直接落字” */
      }

      const ime = document.getElementById('search-ime');
      const imeCompose = ime?.querySelector<HTMLElement>('[data-search-ime-compose]') ?? null;
      const imeList = ime?.querySelector<HTMLElement>('[data-search-ime-list]') ?? null;
      const loading = document.getElementById('search-loading');
      const resultsBox = document.getElementById('search-results');
      const prefersReducedMotion = (): boolean => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let typingToken: object | null = null;
      let searchToken = 0;

      const setLoading = (on: boolean): void => {
        if (loading) loading.hidden = !on;
        if (!resultsBox) return;
        if (on) resultsBox.setAttribute('aria-busy', 'true');
        else resultsBox.removeAttribute('aria-busy');
      };

      const setIme = (on: boolean): void => {
        if (!ime) return;
        if (on) {
          ime.hidden = false;
          ime.classList.add('is-visible');
        } else {
          ime.classList.remove('is-visible');
          ime.hidden = true;
        }
      };

      const setCompose = (text: string): void => {
        if (imeCompose) imeCompose.textContent = text;
      };

      const setCandidates = (chars: string[], active: number): void => {
        if (!imeList) return;
        imeList.replaceChildren(
          ...chars.map((char, index) => {
            const item = document.createElement('span');
            item.className = index === active ? 'search-ime-item is-active' : 'search-ime-item';
            const number = document.createElement('span');
            number.className = 'search-ime-index';
            number.textContent = String(index + 1);
            const glyph = document.createElement('span');
            glyph.className = 'search-ime-glyph';
            glyph.textContent = char;
            item.append(number, glyph);
            return item;
          }),
        );
      };

      const cancelTyping = (): void => {
        if (!typingToken) return;
        typingToken = null;
        setIme(false);
        setCompose('');
        imeList?.replaceChildren();
      };

      const runSearch = async (query: string): Promise<void> => {
        const token = (searchToken += 1);
        const showLoadingLater = (resultsBox?.childElementCount ?? 0) === 0;
        const loadingTimer = showLoadingLater
          ? window.setTimeout(() => {
              if (token === searchToken) setLoading(true);
            }, 140)
          : undefined;
        try {
          if (!pf) return;
          const response = await pf.search(query);
          const items = await Promise.all(response.results.slice(0, 10).map((result) => result.data()));
          if (token !== searchToken) return;
          renderResults(items, query);
        } catch {
          if (token !== searchToken || !resultsBox) return;
          renderResults([], '');
          resultsBox.innerHTML = '<p class="search-empty">搜索暂时不可用，请刷新页面后再试。</p>';
        } finally {
          if (loadingTimer !== undefined) window.clearTimeout(loadingTimer);
          if (token === searchToken) setLoading(false);
        }
      };

      const startTyping = async (word: string): Promise<void> => {
        cancelTyping();
        const token = {};
        typingToken = token;
        const cancelled = (): boolean => typingToken !== token;
        if (field) field.hidden = true;
        renderResults([], '');
        setLoading(false);
        input.focus();
        await typeWordIntoSearch({
          word,
          syllables: typingData.syllables[word] ?? [],
          candidatesFor: (syllable, char) => {
            const pool = typingData.candidates[syllable] ?? [];
            return [char, ...pool.filter((candidate) => candidate !== char)].slice(0, 4);
          },
          reduceMotion: prefersReducedMotion(),
          isCancelled: cancelled,
          hooks: {
            setValue: (value) => {
              if (!cancelled()) input.value = value;
            },
            compose: (text) => {
              if (cancelled()) return;
              if (text) setIme(true);
              setCompose(text);
            },
            candidates: (chars, active) => {
              if (!cancelled()) setCandidates(chars, active);
            },
            hideIme: () => {
              if (!cancelled()) setIme(false);
            },
          },
        });
        if (typingToken !== token) return;
        typingToken = null;
        setIme(false);
        setCompose('');
        imeList?.replaceChildren();
        input.value = word;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      };

      field?.addEventListener('click', (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-word]');
        if (!link) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        const word = link.dataset.word ?? '';
        if (!word) return;
        restoreNote();
        void startTyping(word);
      });
      field?.addEventListener('pointerover', (event) => describe(event.target));
      field?.addEventListener('focusin', (event) => describe(event.target));
      field?.addEventListener('pointerleave', restoreNote);
      field?.addEventListener('focusout', restoreNote);

      let timer: number | undefined;
      input.addEventListener('input', () => {
        cancelTyping();
        const query = input.value.trim();
        if (field) field.hidden = query.length > 0;
        restoreNote();
        syncQuery(query);
        window.clearTimeout(timer);
        if (!query) {
          searchToken += 1;
          setLoading(false);
          renderResults([], '');
          return;
        }
        timer = window.setTimeout(() => {
          void runSearch(query);
        }, 180);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === '/' && document.activeElement !== input) {
          event.preventDefault();
          input.focus();
        }
        if (event.key === 'Escape' && document.activeElement === input) {
          cancelTyping();
          input.blur();
        }
      });

      const initial = new URLSearchParams(window.location.search).get('q');
      if (initial) {
        input.value = initial;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }

    document.addEventListener('astro:page-load', initSearch);
  </script>
</BaseLayout>
